    "Pause or resume tiling": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타일링 일시 정지/재개"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイル表示を一時停止／再開"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停或继续平铺"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停或繼續並排"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause or resume tiling"
          }
        }
      }
    },
    "Pause or resume tiling for the active workspace. While paused, windows keep their current frames.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 작업 공간의 타일링을 일시 정지하거나 다시 시작해요. 멈춘 동안에는 창의 현재 위치와 크기를 유지해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のワークスペースでタイル表示を一時停止または再開します。一時停止中は、ウインドウの現在のフレームを維持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停或继续当前工作区的平铺。暂停期间，窗口会保持当前位置和大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停或繼續目前工作空間的並排。暫停期間，視窗會維持目前的位置與大小。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause or resume tiling for the active workspace. While paused, windows keep their current frames."
          }
        }
      }
    },
    "Periodically check for new Tatami releases.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 Tatami 버전이 있는지 주기적으로 확인해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatamiの新しいバージョンを定期的に確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定期检查 Tatami 新版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "定期檢查 Tatami 新版本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Periodically check for new Tatami releases."
          }
        }
      }
    },
    "Permissions": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한"
          }
        },
        "ja": {
