    "Your final configuration remains readable at ~/.config/tatami/config.toml.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완성된 설정은 ~/.config/tatami/config.toml에서 읽기 쉬운 형태로 유지돼요."
          }
        },
        "ja": {
          "stringUnit": {
