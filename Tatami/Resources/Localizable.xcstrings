          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不共用 · 建議"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing shared—recommended"
          }
        }
      }
    },
    "Now swipe with four fingers. The workspace rail and every window should change together.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 네 손가락으로 밀어 보세요. 작업 공간 목록과 모든 창이 함께 바뀌어야 해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4本指でスワイプしてください。ワークスペースのレールとすべてのウインドウが一緒に切り替わります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在用四指轻扫。工作区轨道和所有窗口应一起切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在用四指滑動。工作空間軌道與所有視窗應一起切換。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now swipe with four fingers. The workspace rail and every window should change together."
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끔"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        }
      }
    },
    "Off preserves ratios you shaped by hand. Other modes may redistribute space when apps enter or leave the BSP tree.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 직접 맞춘 비율을 그대로 유지해요. 다른 모드에서는 앱이 BSP 트리에 들어오거나 나갈 때 공간을 다시 나눌 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフでは、手動で整えた比率を維持します。ほかのモードでは、アプリがBSPツリーへ出入りするときに領域が再配分される場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时保留手动调整的比例。其他模式可能会在应用进入或离开 BSP 树时重新分配空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時保留手動調整的比例。其他模式可能會在 App 進入或離開 BSP 樹時重新分配空間。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off preserves ratios you shaped by hand. Other modes may redistribute space when apps enter or leave the BSP tree."
          }
        }
      }
    },
    "On": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켬"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On"
          }
        }
      }
    },
    "On Activation": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화할 때"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効化時"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用時"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Activation"
          }
        }
      }
    },
    "On makes every context window a stop, including multiple windows from one app. Off cycles app-by-app and recalls each app's most recently used window.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 같은 앱의 여러 창을 포함해 작업 공간의 모든 창을 차례로 방문해요. 끄면 앱 단위로 전환하며 각 앱에서 최근에 쓴 창을 불러와요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンでは、同じアプリの複数ウインドウを含め、作業環境内のすべてのウインドウを順に移動します。オフではアプリ単位で切り替え、各アプリで最近使ったウインドウを呼び戻します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，场景中的每个窗口都会成为切换停靠点，包括同一应用的多个窗口。关闭后按应用切换，并恢复各应用最近使用的窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，工作空間中的每個視窗都會成為切換停靠點，包括同一 App 的多個視窗。關閉後依 App 切換，並還原各 App 最近使用的視窗。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this on to stop at every window, including multiple windows from one app. Turn it off to switch app by app and return to each app’s most recent window."
          }
        }
      }
    },
    "On-device": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 처리"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイス"
          }
        },
        "zh-Hans": {
