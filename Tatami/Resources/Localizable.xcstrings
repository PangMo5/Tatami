    "Walk the configured order or return to the most recently used context.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지정한 순서대로 이동하거나 최근에 사용한 작업 공간으로 돌아가요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定した順番で移動するか、最近使った作業環境へ戻ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按配置顺序移动，或返回最近使用的场景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依照設定順序移動，或返回最近使用的工作空間。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk the configured order or return to the most recently used workspace."
          }
        }
      }
    },
    "Walk through this Tatami context—not the global ⌘Tab list or only one app like ⌘`": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 ⌘Tab 목록이나 ⌘`처럼 앱 하나만 보지 않고, 이 Tatami 작업 공간 안에서 전환해요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グローバルな⌘Tab一覧でも、⌘`のように1つのアプリ内だけでもなく、このTatamiの作業環境を順に切り替えします"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只浏览此 Tatami 场景，而不是全局 ⌘Tab 列表，也不像 ⌘` 那样局限于单个应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只瀏覽這個 Tatami 工作空間，而不是全域 ⌘Tab 列表，也不像 ⌘` 僅限於單一 App"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk through this Tatami workspace—not the global ⌘Tab list or only one app like ⌘`"
          }
        }
      }
    },
    "Welcome": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반가워요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ようこそ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome"
          }
        }
      }
    },
    "What fills a typical week?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소 한 주에는 어떤 일을 하나요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普段の1週間は、どんな仕事で構成されていますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平常一周主要做哪些工作？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平常一週主要做哪些工作？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What fills a typical week?"
          }
        }
      }
    },
    "What the menu bar item shows. With everything off it falls back to a single icon.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에 보여줄 항목을 선택해요. 모두 끄면 아이콘 하나만 표시돼요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバー項目に表示する内容です。すべてオフの場合は、1つのアイコンだけを表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择菜单栏项目显示的内容。全部关闭时会只显示一个图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇選單列項目顯示的內容。全部關閉時只會顯示一個圖示。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the menu bar item shows. With everything off it falls back to a single icon."
          }
        }
      }
    },
    "What's New in Tatami %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatami %@의 새로운 기능"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatami %@の新機能"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatami %@ 新功能"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatami %@ 的新功能"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's New in Tatami %@"
          }
        }
      }
    },
    "When on, auto-switch to this profile as the monitors match — all conditions apply together. Per monitor: Required = must be connected, Excluded = must be unplugged.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 모니터 구성이 모든 조건과 일치할 때 이 프로필로 자동 전환해요. ‘필수’ 모니터는 연결되어 있어야 하고, ‘제외’ 모니터는 연결되어 있으면 안 돼요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、ディスプレイ構成が一致したときにこのプロファイルへ自動で切り替えます。すべての条件が同時に適用されます。各ディスプレイで「必須」は接続中、「対象外」は未接続である必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，显示器匹配时自动切换到此配置方案，且所有条件需同时满足。每台显示器：“必需”表示必须连接，“已排除”表示必须断开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，顯示器符合時會自動切換至這個設定組合，而且所有條件都必須同時符合。每台顯示器：「必要」代表必須連接，「已排除」代表必須拔除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, auto-switch to this profile as the monitors match — all conditions apply together. Per monitor: Required = must be connected, Excluded = must be unplugged."
          }
        }
      }
    },
    "When Tatami changes the focused managed window, the pointer follows it—even across the host and a borrowed block. Focus and Cycle move it to the new window; Swap keeps it attached to that same window in its new tile.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatami가 관리 창의 포커스를 바꾸면 포인터도 따라가요. 호스트와 빌려온 블록 사이도 넘을 수 있어요. 포커스와 전환은 새 창으로 포인터를 옮기고, 교체는 같은 창이 새 타일로 이동해도 계속 붙어 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatamiが管理対象ウインドウのフォーカスを変えると、ホストと借りたブロックの間でもポインタが追従します。フォーカスと切り替えでは新しいウインドウへ移動し、入れ替えでは同じウインドウが新しいタイルへ移っても追従し続けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Tatami 更改受管理焦点窗口时，指针会随之移动，即使跨越主工作区与借用区块。焦点和切换会将指针移到新窗口；交换则会让指针继续跟随移动到新平铺位置的同一窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 Tatami 變更受管理焦點視窗時，游標會跟著移動，即使跨越主工作空間與借用區塊。焦點與切換會將游標移至新視窗；交換則會讓游標繼續跟隨移至新並排位置的同一視窗。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Tatami changes the focused managed window, the pointer follows it—even between the host and a borrowed block. Directional Focus and Window Switching move it to the new window. Swap keeps it with the same window in its new tile."
          }
        }
      }
    },
    "When the focused window disappears, Tatami selects the next managed window instead of leaving keyboard focus nowhere.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스한 창이 사라지면 키보드 포커스를 잃지 않도록 다음 관리 창을 선택해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のウインドウが消えたら、キーボードフォーカスが宙に浮かないよう、次の管理対象ウインドウを選びます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "焦点窗口消失时，Tatami 会选择下一个受管理窗口，避免键盘焦点无处可去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "焦點視窗消失時，Tatami 會選擇下一個受管理視窗，避免鍵盤焦點無處可去。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the focused window disappears, Tatami selects the next managed window instead of leaving keyboard focus nowhere."
          }
        }
      }
    },
    "When the last window in the active workspace closes, switch to the recent workspace. Shared apps don't count — they join every workspace anyway.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 작업 공간의 마지막 창을 닫으면 최근 작업 공간으로 돌아가요. 모든 작업 공간에 들어가는 공용 앱은 창 수에 포함하지 않아요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のワークスペースで最後のウインドウを閉じたら、直前のワークスペースへ戻ります。すべてのワークスペースに含まれる共有アプリは数えません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭当前工作区的最后一个窗口时，切换到最近使用的工作区。共享应用不计入，因为它们本就加入每个工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉目前工作空間的最後一個視窗時，切換至最近使用的工作空間。共用 App 不列入計算，因為它們本來就會加入每個工作空間。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the last window in the active workspace closes, switch to the recent workspace. Shared apps don't count — they join every workspace anyway."
          }
        }
      }
    },
    "When the pointer enters any managed preview window, including a borrowed one, Tatami gives it keyboard focus. Pointer movement leads; focus follows afterward.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터가 빌려온 창을 포함한 관리 미리 보기 창에 들어가면 키보드 포커스를 줘요. 포인터가 먼저 움직이고 포커스가 따라와요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "借りているものを含む管理対象のプレビューウインドウへポインタが入ると、Tatamiがキーボードフォーカスを与えます。ポインタの移動が先で、フォーカスが後から追従します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针进入任何受管理预览窗口时，包括借用窗口，Tatami 都会赋予键盘焦点。指针移动在前，焦点随后跟上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "游標進入任何受管理預覽視窗時，包括借用視窗，Tatami 都會給予鍵盤焦點。游標移動在前，焦點隨後跟上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the pointer enters any managed preview window, including a borrowed one, Tatami gives it keyboard focus. Pointer movement leads; focus follows afterward."
          }
        }
      }
    },
    "When the pointer moves over a managed window, give that window keyboard focus.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터가 관리 창 위로 움직이면 그 창에 키보드 포커스를 줘요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理対象ウインドウへポインタを動かすと、そのウインドウへキーボードフォーカスを与えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针移到受管理窗口上时，赋予该窗口键盘焦点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "游標移到受管理視窗上時，給予該視窗鍵盤焦點。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the pointer moves over a managed window, give that window keyboard focus."
          }
        }
      }
    },
    "Where a borrow docks. “Ask” means press a direction (h/j/k/l or arrows) after the borrow combo. A workspace can override this.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌려온 작업 공간을 붙일 위치예요. 물어보기는 빌려오기 키 조합 뒤에 h/j/k/l 또는 방향키를 누르는 방식이에요. 작업 공간별로 다른 값을 지정할 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "借りるときの配置場所です。「毎回選ぶ」では、「借りる」のキーを押した後にh/j/k/lまたは矢印キーで方向を決めます。ワークスペースごとに上書きできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "借用的停靠位置。“询问”表示按下借用组合键后，再按 h/j/k/l 或方向键。每个工作区可单独覆盖此值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "借用的停靠位置。「詢問」代表按下借用組合鍵後，再按 h/j/k/l 或方向鍵。每個工作空間可個別覆寫這個值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where a borrow docks. “Ask” means press a direction (h/j/k/l or arrows) after the borrow combo. A workspace can override this."
          }
        }
      }
    },
    "Where this workspace docks when borrowed. Change the global default in Settings.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간을 빌려올 때 붙일 위치예요. 전역 기본값은 설정에서 바꿀 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースを借りたときの配置場所です。全体の初期値は「設定」で変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作区借用时的停靠位置。可在“设置”中更改全局默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個工作空間借用時的停靠位置。可在「設定」中變更全域預設值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where this workspace docks when borrowed. Change the global default in Settings."
          }
        }
      }
    },
    "Which assigned app gets focus when this workspace activates.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간을 활성화할 때 먼저 포커스할 앱이에요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースを有効にしたとき、最初にフォーカスするアプリです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用此工作区时优先聚焦的已分配应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用這個工作空間時優先聚焦的已指派 App。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which assigned app gets focus when this workspace activates."
          }
        }
      }
    },
    "Which side of the new split holds the inserted window.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 분할에서 추가된 창을 놓을 쪽이에요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい分割で、追加したウインドウを置く側です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新分区中放置新增窗口的一侧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新分割區中放置新增視窗的一側。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which side of the new split holds the inserted window."
          }
        }
      }
    },
