    "Exchange with a directional neighbor; at an outer edge, turn the parent split toward that direction.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 방향의 이웃과 교체해요. 바깥쪽 가장자리에서는 상위 분할을 그 방향으로 돌려요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定方向の隣と入れ替えます。外端では親分割をその方向へ向けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与指定方向的相邻项交换；位于外边缘时，将上级分割转向该方向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與指定方向的相鄰項目交換；位於外側邊緣時，將上層分割轉向該方向。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap with a window in that direction. At an outer edge, change the split direction instead."
          }
        }
      }
    },
    "Exchange with the right neighbour, or turn the parent split right at an outer edge": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 이웃과 자리를 바꿔요. 바깥쪽 끝에서는 상위 분할을 오른쪽으로 돌려요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右隣と入れ替えます。外端では親の分割を右へ回転します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与右侧相邻窗口交换；位于外侧边缘时，将父级分区转向右侧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與右側相鄰視窗交換；位於外側邊緣時，將上層分割區轉向右側。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap with the window on the right, or change the split direction at an outer edge."
          }
        }
      }
    },
    "Excluded": {
