    "Review another profile's differences and copy the ones you pick into this profile's matching workspaces (by name).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 프로필과의 차이를 확인하고, 고른 항목만 이 프로필에서 이름이 같은 작업 공간에 복사해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のプロファイルとの差分を確認し、選んだ項目だけをこのプロファイル内で名前が一致するワークスペースへコピーします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看与其他配置方案的差异，并将所选项目复制到此配置方案中名称相同的工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視與其他設定組合的差異，並將所選項目複製至這個設定組合中名稱相同的工作空間。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review another profile's differences and copy the ones you pick into this profile's matching workspaces (by name)."
          }
        }
      }
    },
