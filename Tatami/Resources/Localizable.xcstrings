    "Split toggles the selected branch between horizontal and vertical while keeping the same apps.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분할은 앱을 그대로 둔 채 선택한 분기의 방향을 가로와 세로 사이에서 바꿔요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分割では、同じアプリを維持したまま、選択した分岐を横方向と縦方向で切り替えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分区会在保留原有应用的同时，将所选分支在水平与垂直之间切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分割會在保留原有 App 的同時，將所選分支在水平與垂直之間切換。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split changes the selected group between horizontal and vertical without changing its apps."
          }
        }
      }
    },
    "Split-tree layout · safe draft": {
      "localizations": {
        "ko": {
          "stringUnit": {
