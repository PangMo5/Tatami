    "Zoomed the focused window": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스한 창을 확대했어요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のウインドウを拡大しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
