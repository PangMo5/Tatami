    "Brief on-screen overlay confirming actions. The toggles below pick which.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동작 결과를 화면에 짧게 알려줘요. 아래에서 표시할 항목을 고를 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作結果を画面上で短く確認できます。表示する項目は下で選べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在屏幕上短暂显示操作结果。可在下方选择要显示的项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在畫面上短暫顯示操作結果。可在下方選擇要顯示的項目。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show brief on-screen feedback after selected actions."
          }
        }
      }
    },
    "Brief overlays confirm focus, swap, resize, workspace, and layout commands without opening Settings.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 열지 않아도 포커스, 교체, 크기 조절, 작업 공간, 배치 명령의 결과를 화면 알림으로 확인할 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開かなくても、フォーカス、入れ替え、サイズ変更、ワークスペース、レイアウト操作の結果を画面上で確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需打开设置，也能在屏幕上确认焦点、交换、调整大小、工作区和布局操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不必打開設定，也能在畫面上確認焦點、交換、調整大小、工作空間與佈局操作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm focus, swap, resize, workspace, and layout actions without opening Settings."
          }
        }
      }
    },
    "Bring one context beside another without mixing layouts.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배치를 섞지 않고 한 작업 공간을 다른 작업 공간 옆으로 가져와요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトを混ぜずに、別の作業環境を隣へ並べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将一个场景放到另一个旁边，但不混合布局。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將一個工作空間放到另一個旁邊，但不混合佈局。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring one workspace beside another without mixing layouts."
          }
        }
      }
    },
