    },
    "Only app metadata and display names are used during setup.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정할 때는 앱 메타데이터와 디스플레이 이름만 사용해요."
          }
        },
        "ja": {
