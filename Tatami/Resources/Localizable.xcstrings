    "%lld apps always arrive": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 %lld개를 항상 함께 불러와요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld個のアプリを常にまとめて呼び出します"
