    },
    "Shared app — in every workspace": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공용 앱 · 모든 작업 공간에 표시"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
