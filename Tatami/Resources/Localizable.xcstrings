    "Borrowing a workspace in beside another, or returning it.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간을 빌려오거나 돌려보낼 때 보여줘요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースを別のワークスペースの隣に一時表示するか、元に戻します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将一个工作区临时放到另一个工作区旁，或将其归还。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將一個工作空間暫時放到另一個工作空間旁，或將它歸還。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrowing a workspace in beside another, or returning it."
          }
        }
      }
    },
    "Both axes": {
