          }
        }
      }
    },
    "One app · borrow only": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 하나 · 빌려오기 전용"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1アプリ · 借りるときだけ表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单个应用 · 仅供借用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單一 App · 僅供借用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One app · borrow only"
          }
        }
      }
    },
    "One key for this workspace — hold it with the switch / assign / borrow modifier (Settings → Workspace Keys) to run each action.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간에는 키 하나를 사용해요. ‘설정 → 작업 공간 키’의 전환/지정/빌려오기 보조 키와 함께 누르면 각 동작이 실행돼요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースではキーを1つ使います。「設定 → ワークスペースキー」の切り替え／割り当て／「借りる」の修飾キーと組み合わせて、各操作を実行します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作区使用一个按键。配合“设置 → 工作区按键”中的切换/分配/借用修饰键，即可执行相应操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個工作空間使用一個按鍵。搭配「設定 → 工作空間按鍵」中的切換／指派／借用修飾鍵，即可執行對應操作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One key for this workspace — hold it with the switch / assign / borrow modifier (Settings → Workspace Keys) to run each action."
          }
        }
      }
    },
    "One-app quick access": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 하나 빠른 실행"
          }
        },
        "ja": {
