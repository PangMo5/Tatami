    "Equalize all split ratios as an explicit layout reset.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 분할 비율을 균등하게 맞춰 배치를 초기화해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての分割比率を均等にして、レイアウトを明示的にリセットします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所有分割比例调为一致，明确重置布局。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將所有分割比例調為一致，明確重設版面。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Equalize all split ratios as an explicit layout reset."
          }
        }
      }
    },
    "Equalize every split": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 분할을 균등하게"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての分割を均等にする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "均衡所有分区"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平衡所有分割區"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Equalize every split"
          }
        }
      }
    },
    "Equalize every split whenever a window is added or removed.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창이 추가되거나 사라질 때마다 모든 분할 비율을 같게 맞춰요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウが追加または削除されるたびに、すべての分割比率を揃えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次添加或移除窗口时，自动均衡所有分区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次加入或移除視窗時，自動平衡所有分割區。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Equalize every split whenever a window is added or removed."
          }
        }
      }
    },
    "Every app appears under its current destination. Use its menu to move it without losing the overview.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 앱이 현재 소속된 곳 아래에 보여요. 전체 구성을 한눈에 보면서 메뉴로 앱을 옮길 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのアプリが現在の配置先に表示されます。全体を見渡したまま、メニューから移動できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个应用都会显示在当前归属位置下。可通过菜单移动应用，同时保持全局视图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個 App 都會顯示在目前歸屬位置下。可透過選單移動 App，同時保留全局檢視。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every app appears under its current destination. Use its menu to move it without losing the overview."
          }
        }
      }
    },
