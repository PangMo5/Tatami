    "Ignore full-screen windows": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 창은 포커스하지 않기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンウインドウを対象外にする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略全屏窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略全螢幕視窗"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore full-screen windows"
          }
        }
      }
    },
    "Ignore workspaces with no running apps when cycling next/previous.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음/이전으로 전환할 때 실행 중인 앱이 없는 작업 공간은 건너뛰어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次／前へ切り替えるとき、実行中のアプリがないワークスペースを飛ばします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换到下一个/上一个时，跳过没有运行中应用的工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換至下一個／上一個時，略過沒有執行中 App 的工作空間。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip workspaces with no running apps when switching to the next or previous workspace."
          }
        }
      }
    },
    "Implement and run one change": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 하나를 구현하고 실행해요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を1つ実装して実行する"
          }
        },
        "zh-Hans": {
