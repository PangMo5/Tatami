    "Next/Previous walks the full profile rather than staying on the pointer display's workspace list.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음/이전은 포인터가 있는 디스플레이에 머물지 않고 프로필의 모든 작업 공간을 이동해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次／前では、ポインタがあるディスプレイの一覧に限定せず、プロファイル全体を移動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“下一个/上一个”会遍历整个配置方案，而不是只在指针所在显示器的工作区列表中移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「下一個／上一個」會走訪整個設定組合，而不只在游標所在顯示器的工作空間列表中移動。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next/Previous walks the full profile rather than staying on the pointer display's workspace list."
          }
        }
      }
    },
    "Next/previous workspace cycles through every display's workspaces instead of just the one under the cursor.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음/이전 작업 공간은 포인터 아래 디스플레이뿐 아니라 모든 디스플레이의 작업 공간을 차례로 전환해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次／前のワークスペース切り替えで、ポインタ下のディスプレイだけでなく、すべてのディスプレイのワークスペースを順に切り替えします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换下一个/上一个工作区时，会切换所有显示器的工作区，而不只限于指针所在的显示器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換下一個／上一個工作空間時，會切換所有顯示器的工作空間，而不只限於游標所在的顯示器。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next and Previous Workspace can switch through workspaces on every display, not only the display under the pointer."
          }
        }
      }
    },
    "No apps assigned yet": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 지정한 앱이 없어요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
