    "Go back to Workspaces and assign at least two apps to practice moving and resizing tiles.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간으로 돌아가 앱을 두 개 이상 지정해 주세요. 그래야 타일 이동과 크기 조절을 연습할 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ワークスペース」に戻り、アプリを2つ以上割り当ててください。タイルの移動とサイズ変更を練習できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回“工作区”并至少分配两个应用，即可练习移动和调整平铺窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "返回「工作空間」並至少指派兩個 App，即可練習移動與調整並排視窗。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go back to Workspaces and assign at least two apps to practice moving and resizing tiles."
          }
        }
      }
    },
    "Going past the last workspace returns to the first, so repeated Next/Previous commands never dead-end.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 작업 공간 다음에는 첫 작업 공간으로 돌아가요. 다음/이전을 계속 눌러도 막히지 않아요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後のワークスペースの次は先頭へ戻ります。「次へ／前へ」を繰り返しても行き止まりになりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "越过最后一个工作区后会回到第一个，因此连续使用“下一个/上一个”不会卡住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "越過最後一個工作空間後會回到第一個，因此連續使用「下一個／上一個」不會卡住。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Going past the last workspace returns to the first, so repeated Next/Previous commands never dead-end."
          }
        }
      }
    },
    "Grant Accessibility and Screen Recording in System Settings → Privacy & Security, then relaunch Tatami": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘시스템 설정 → 개인정보 보호 및 보안’에서 손쉬운 사용과 화면 기록을 허용한 뒤 Tatami를 다시 실행하세요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定 → プライバシーとセキュリティ」でアクセシビリティと画面収録を許可し、Tatamiを再起動してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置 → 隐私与安全性”中授予辅助功能和屏幕录制权限，然后重新启动 Tatami"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定 → 隱私權與安全性」中允許輔助使用和螢幕錄製，然後重新啟動 Tatami"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Accessibility and Screen Recording in System Settings → Privacy & Security, then relaunch Tatami"
          }
        }
      }
    },
    "Grant Accessibility in System Settings → Privacy & Security, then relaunch Tatami": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘시스템 설정 → 개인정보 보호 및 보안’에서 손쉬운 사용을 허용한 뒤 Tatami를 다시 실행하세요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定 → プライバシーとセキュリティ」でアクセシビリティを許可し、Tatamiを再起動してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置 → 隐私与安全性”中授予辅助功能权限，然后重新启动 Tatami"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定 → 隱私權與安全性」中允許輔助使用，然後重新啟動 Tatami"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Accessibility in System Settings → Privacy & Security, then relaunch Tatami"
          }
        }
      }
    },
    "Grant…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한 허용…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant…"
          }
        }
      }
    },
    "Granted — floating windows can be mirrored above the tiles.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 기록을 허용했어요. 창을 타일 위에 미러로 표시할 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可済み — ウインドウをタイル表示より手前に表示できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权 — 可以将窗口镜像置顶到平铺布局上方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已允許 — 可以將視窗鏡像置頂至並排佈局上方。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed — Tatami can keep mirrored windows above the tiled layout."
          }
        }
      }
    },
    "Granted — local floating mirrors are available.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 기록을 허용했어요. 이 Mac에서 ‘항상 위’ 미러를 사용할 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可済み — このMacで「常に手前」を使用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权 — 可以在这台 Mac 上使用置顶窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已允許 — 可以在這台 Mac 上使用置頂視窗。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed — always-on-top windows are available on this Mac."
          }
        }
      }
    },
    "Granted — Tatami can move, resize, and focus windows.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용을 허용했어요. Tatami가 창을 옮기고 크기를 바꾸고 포커스할 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可済み — Tatamiでウインドウの移動、サイズ変更、フォーカスができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权 — Tatami 可以移动、调整窗口大小并聚焦窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已允許 — Tatami 可以移動、調整視窗大小並聚焦視窗。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Granted — Tatami can move, resize, and focus windows."
          }
        }
      }
    },
    "Grew the focused window by one step": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스한 창을 한 단계 키웠어요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のウインドウを1段階拡大しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将聚焦窗口放大一级"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已將聚焦視窗放大一級"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grew the focused window by one step"
          }
        }
      }
    },
    "Group by work you enter, not by app category": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 종류가 아니라 시작하려는 일로 묶어요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの種類ではなく、取り組む仕事でまとめます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按要做的事分组，而不是按应用类别"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依要做的事分組，而不是依 App 類別"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group by work you enter, not by app category"
          }
        }
      }
    },
    "Grow": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "늘리기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡大"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩大"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放大"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grow"
          }
        }
      }
    },
    "Grow / Shrink": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키우기/줄이기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡大／縮小"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大/缩小"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放大/縮小"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grow / Shrink"
          }
        }
      }
    },
    "Grow window": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창 늘리기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウを拡大"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩大窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放大視窗"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grow window"
          }
        }
      }
    },
    "Grow/Shrink changes the ratio of the split that owns the focused tile; dragging a divider writes the same value.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "늘리기/줄이기는 포커스한 타일이 속한 분할 비율을 바꿔요. 구분선을 드래그해도 같은 값이 저장돼요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡大／縮小では、フォーカス中のタイルを含む分割の比率を変更します。仕切りをドラッグしても同じ値が保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩大/缩小会调整焦点平铺窗口所属分区的比例；拖动分隔线也会写入同一个值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放大／縮小會調整焦點並排視窗所屬分割區的比例；拖曳分隔線也會寫入相同的值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grow/Shrink changes the ratio of the split that owns the focused tile; dragging a divider writes the same value."
          }
        }
      }
    },
    "Guided Setup": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가이드 설정"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガイド設定"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引导设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引導設定"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guided Setup"
          }
        }
      }
    },
    "Handling is saved on that app assignment inside this draft workspace.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 관리 방식은 초안 작업 공간의 해당 앱 설정에 저장돼요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この扱い方は、下書きワークスペース内のアプリ割り当てに保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此管理方式会保存到草稿工作区中的应用分配设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個管理方式會儲存至草稿工作空間中的 App 指派設定。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handling is saved on that app assignment inside this draft workspace."
          }
        }
      }
    },
    "Handling mode": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리 방식"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "扱い方"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理方式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理方式"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handling mode"
          }
        }
      }
    },
    "Held with a key equivalent to switch workspaces. Each workspace's key is set in its own settings; the built-in targets below cover recent / next / previous. Clear it to disable key-equivalent switching.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간 키와 함께 눌러 전환해요. 각 작업 공간의 키는 해당 설정에서 정하고, 아래 기본 대상은 최근/다음/이전 작업 공간을 다뤄요. 키 조합 전환을 끄려면 이 값을 지우세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースのキーと組み合わせて切り替えます。各ワークスペースのキーはそれぞれの設定で指定し、下の内蔵ターゲットでは直前／次／前を扱います。キー相当の切り替えを無効にするには消去してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住此修饰键并配合工作区按键即可切换。每个工作区的按键在各自设置中指定；下方内置目标用于最近/下一个/上一个。清除此项可关闭按键组合切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住這個修飾鍵並搭配工作空間按鍵即可切換。每個工作空間的按鍵會在各自設定中指定；下方內建目標用於最近／下一個／上一個。清除此項可關閉按鍵組合切換。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Held with a key equivalent to switch workspaces. Each workspace's key is set in its own settings; the built-in targets below cover recent / next / previous. Clear it to disable key-equivalent switching."
          }
        }
      }
    },
    "Held with a workspace's key equivalent to assign the focused app to it.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간 키와 함께 누르면 포커스한 앱을 그 작업 공간에 지정해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースのキーと組み合わせると、フォーカス中のアプリをそこへ割り当てます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住此修饰键并配合工作区按键，即可将焦点应用分配到该工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住這個修飾鍵並搭配工作空間按鍵，即可將焦點 App 指派至該工作空間。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Held with a workspace's key equivalent to assign the focused app to it."
          }
        }
      }
    },
    "Held with a workspace's key equivalent to borrow it into the current screen — then a direction key places it.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간 키와 함께 누르면 현재 화면으로 빌려와요. 이어서 방향키로 위치를 정해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースのキーと組み合わせると、現在の画面の隣へ一時表示します。その後、方向キーで配置します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住此修饰键并配合工作区按键，即可将其借用当前屏幕；再用方向键放置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住這個修飾鍵並搭配工作空間按鍵，即可將它借用目前畫面；再用方向鍵放置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Held with a workspace's key equivalent to borrow it into the current screen — then a direction key places it."
          }
        }
      }
    },
    "Hide cursor on focus": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스할 때 포인터 숨기기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス時にポインタを隠す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聚焦时隐藏指针"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聚焦時隱藏游標"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide cursor on focus"
          }
        }
      }
    },
    "Hide the cursor on a workspace switch until you move the mouse.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간을 전환하면 마우스를 움직일 때까지 포인터를 숨겨요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースを切り替えた後、マウスを動かすまでポインタを隠します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换工作区后隐藏指针，直到你移动鼠标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換工作空間後隱藏游標，直到你移動滑鼠。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the cursor on a workspace switch until you move the mouse."
          }
        }
      }
    },
    "Hide the dot while the cursor is over it.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터가 점 위에 있으면 점을 숨겨요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタがドットに重なっている間は非表示にします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针位于圆点上时隐藏圆点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "游標位於圓點上時隱藏圓點。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the dot while the cursor is over it."
          }
        }
      }
    },
    "High": {
      "localizations": {
        "ko": {
