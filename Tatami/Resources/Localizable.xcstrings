    "Removes the tatami symlink from /usr/local/bin. You can reinstall it anytime from here.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "/usr/local/bin에서 tatami 심볼릭 링크를 제거해요. 여기서 언제든 다시 설치할 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/usr/local/binからtatamiのシンボリックリンクを削除します。ここからいつでも再インストールできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 /usr/local/bin 中移除 tatami 符号链接。你可以随时在此重新安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 /usr/local/bin 移除 tatami 符號連結。你可以隨時在這裡重新安裝。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the tatami symlink from /usr/local/bin. You can reinstall it anytime from here."
          }
        }
      }
    },
    "Repeated summon dismissed %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 빌려와서 돌려보냈어요 · %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度呼び出して%@を戻しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次召出后已返回 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再次叫出後已返回 %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrowed again and returned %@"
          }
        }
      }
    },
    "Repeating the same Borrow command becomes a toggle. Off keeps repeat presses idempotent until you use Dismiss Borrow.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 같은 빌려오기 명령을 다시 눌러 돌려보낼 수 있어요. 끄면 ‘빌려온 작업 공간 돌려보내기’를 누르기 전까지 그대로 유지해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、同じ「借りる」コマンドをもう一度実行したときに元へ戻します。オフでは、「借りたワークスペースを戻す」を使うまで、繰り返し実行しても状態は変わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，再次执行同一借用命令会归还工作区。关闭后，重复执行不会改变状态，直到你选择“归还借用工作区”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，再次執行相同借用指令會歸還工作空間。關閉後，重複執行不會改變狀態，直到你選擇「歸還借用工作空間」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this on to return a borrowed workspace when you use the same Borrow command again. When off, repeat commands leave it in place until you choose Return Borrowed Workspace."
          }
        }
      }
    },
    "Replace the visible task context with one named workspace.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 작업 공간에서 선택한 작업 공간으로 전환해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中の作業作業環境を指定したワークスペースに置き換えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用指定工作区替换当前可见的任务场景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從目前的工作空間切換到所選的工作空間。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch from the visible workspace to one you choose."
          }
        }
      }
    },
