    },
    "This workspace no longer exists.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간은 더 이상 존재하지 않아요. 사이드바에서 다른 작업 공간을 선택해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースは存在しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作区已不存在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個工作空間已不存在。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This workspace no longer exists."
          }
        }
      }
    },
    "This workspace's share of the screen when borrowed.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간을 빌려올 때 차지할 화면 비율이에요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースを借りたときに使う画面の割合です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作区借用时占用的屏幕比例。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個工作空間借用時占用的螢幕比例。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This workspace's share of the screen when borrowed."
          }
        }
      }
    },
    "Three fingers stays local to this workspace; four fingers replaces the entire task context.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 손가락은 현재 작업 공간 안에서만 창을 바꾸고, 네 손가락은 하던 일 전체를 바꿔요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3本指はこのワークスペース内だけを切り替え、4本指は仕事の作業環境全体を置き換えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三指只在当前工作区内切换；四指会替换整个任务场景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三指只在目前的工作空間內切換；四指會取代整個工作空間。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A three-finger gesture stays within the current workspace; a four-finger gesture switches workspaces."
          }
        }
      }
    },
    "Three-Finger Swipes": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 손가락 스와이프"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3本指スワイプ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三指轻扫"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三指滑動"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three-Finger Swipes"
          }
        }
      }
    },
    "Tiled": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타일링"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイル表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平铺"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "並排"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiled"
          }
        }
      }
    },
    "Tiled lets Tatami place the window, Floating creates an always-on-top mirror, and Ignore preserves the app's own geometry.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타일링은 Tatami가 창을 배치해요. ‘항상 위’는 타일 위에 보이는 미러를 만들고, ‘그대로 두기’는 앱의 현재 위치와 크기를 유지해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「タイル表示」ではTatamiがウインドウを配置します。「常に手前」ではライブ映像をほかのウインドウより手前に置き、「そのまま」では現在の位置とサイズを維持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“平铺”由 Tatami 排列窗口；“置顶”会在布局上方显示实时画面；“保持原样”会保留窗口当前的位置和大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「並排」由 Tatami 排列視窗；「置頂」會在佈局上方顯示即時畫面；「維持原狀」會保留視窗目前的位置與大小。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiled lets Tatami arrange the window. Always on Top keeps a live view above the layout. Leave As Is preserves the window’s current position and size."
          }
        }
      }
    },
    "Tiled: %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타일링: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイル表示：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平铺：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "並排：%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiled: %@"
          }
        }
      }
    },
    "Tiled: laid out in the BSP tree. Float: mirrored above the tiles. Ignore: left where it is — still a member (focus, FFM, cycling), no Screen Recording.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타일링: BSP 트리에 배치해요. 항상 위: 타일 위에 미러로 보여줘요. 그대로 두기: 현재 위치를 유지하면서 포커스·FFM·전환에는 포함하고, 화면 기록 권한은 사용하지 않아요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイル表示：BSPレイアウトへ配置。常に手前：ほかのウインドウより手前にライブ表示。そのまま：現在の位置とサイズを維持しながら、フォーカスや切り替えには参加。画面収録は不要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平铺：加入 BSP 布局。置顶：镜像显示在其他窗口上方。保持原样：保留当前位置和大小，但仍参与焦点与窗口切换，且无需屏幕录制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "並排：加入 BSP 佈局。置頂：鏡像顯示在其他視窗上方。維持原狀：保留目前的位置與大小，但仍參與焦點與視窗切換，而且不需要螢幕錄製。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiled: arranged in the BSP layout. Always on Top: mirrored above it. Leave As Is: keeps its position and size while remaining available to focus and window switching. No Screen Recording required."
          }
        }
      }
    },
