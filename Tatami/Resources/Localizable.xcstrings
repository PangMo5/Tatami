    "Prepare Tatami for this Mac without unnecessary access.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꼭 필요한 권한만 허용하고 이 Mac에서 Tatami를 준비해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不要なアクセスを許可せず、このMacでTatamiを使う準備をします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只授予必要权限，为此 Mac 准备 Tatami。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只允許必要權限，為這台 Mac 準備 Tatami。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare Tatami for this Mac without unnecessary access."
          }
        }
      }
    },
    "Present, discuss, and capture decisions": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유하고 논의해 결정을 기록해요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
