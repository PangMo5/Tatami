    "Next workspace": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 작업 공간"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のワークスペース"
          }
        },
