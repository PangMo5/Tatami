    "Calling the same workspace already borrowed on this display returns it and restores the host workspace.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 디스플레이에 이미 빌려온 작업 공간을 다시 부르면 돌려보내고, 호스트 작업 공간을 원래대로 복원해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このディスプレイですでに借りているワークスペースをもう一度呼ぶと、元に戻してホストのワークスペースを復元します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次召出已借用此显示器的同一工作区，会将其归还并恢复主工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再次叫出已借用這台顯示器的同一工作空間，會將它歸還並還原主工作空間。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calling the same workspace already borrowed on this display returns it and restores the host workspace."
          }
        }
      }
    },
