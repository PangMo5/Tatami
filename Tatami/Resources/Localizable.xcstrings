    "Learn switching in a virtual display": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상 디스플레이에서 전환 익히기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想ディスプレイで切り替えを学ぶ"
          }
        },
        "zh-Hans": {
