      }
    },
    "Pause / resume this macOS Space": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 macOS Space 일시 정지/재개"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
