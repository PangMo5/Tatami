    "Separate collecting sources from writing conclusions. Keep lookup tools temporary.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자료를 모으는 일과 결론을 쓰는 일을 나눠요. 검색 도구는 필요할 때만 잠깐 빌려와요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資料収集と結論の執筆を分けます。検索ツールは必要なときだけ一時的に使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将收集资料与撰写结论分开，查询工具只在需要时临时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將收集資料與撰寫結論分開，查詢工具只在需要時暫時使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate collecting sources from writing conclusions. Keep lookup tools temporary."
          }
        }
      }
    },
    "Separate focused creation from collaborative critique. Keep quick capture lightweight.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중해서 만드는 시간과 함께 검토하는 시간을 나눠요. 빠른 기록은 가볍게 꺼내 쓰세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中して作る時間と、共同でレビューする時間を分けます。クイックキャプチャは軽く使える形にします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将专注创作与协作评审分开，并让快速记录保持轻量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將專注創作與協作檢視分開，並讓快速記錄保持輕量。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate focused creation from collaborative critique. Keep quick capture lightweight."
          }
        }
      }
    },
    "Separate making a change from reviewing one. Keep a one-app terminal check temporary.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경하는 일과 검토하는 일을 나눠요. 앱 하나만 쓰는 터미널 확인은 필요할 때만 잠깐 열어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更する作業とレビューする作業を分けます。1アプリだけのターミナル確認は一時的に呼び出します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将修改与审查分开，单应用终端检查只需临时调用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將修改與審查分開，單一 App 的終端機檢查只需暫時叫出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate making a change from reviewing one. Keep a one-app terminal check temporary."
          }
        }
      }
    },
    "Separate planning from discovery so meetings and evidence do not become one giant context.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획과 탐색을 나눠 회의와 자료가 하나의 거대한 작업 공간으로 섞이지 않게 해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計画と探索を分け、会議と根拠資料が1つの巨大な作業環境に混ざらないようにします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将规划与探索分开，避免会议和资料混成一个庞大场景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將規劃與探索分開，避免會議與資料混成一個龐大工作空間。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate planning from discovery so meetings and evidence do not become one giant workspace."
          }
        }
      }
    },
