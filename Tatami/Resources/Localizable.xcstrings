    "Zoom": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확대"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ズーム"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩放"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮放"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom"
          }
        }
      }
    },
    "Zoom one tile": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타일 하나 확대"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つのタイルをズーム"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩放一个平铺窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮放一個並排視窗"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom one tile"
          }
        }
      }
    },
    "Zoom temporarily gives the selected tile the workspace canvas. Toggle it again to restore the remembered tree.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확대하면 선택한 타일이 작업 공간 전체를 잠시 사용해요. 다시 누르면 기억된 트리 배치로 돌아가요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ズームすると、選択したタイルが一時的にワークスペース全体を使います。もう一度切り替えると、記憶したツリーへ戻ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩放会暂时让所选平铺窗口占满工作区画布。再次切换即可恢复已记住的树。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮放會暫時讓所選並排視窗填滿工作空間畫布。再次切換即可還原已記住的樹。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom temporarily gives the selected tile the workspace canvas. Toggle it again to restore the remembered tree."
          }
        }
      }
    },
    "Zoom the focused tile inside its workspace, then restore the tree.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스한 타일을 작업 공간 안에서 확대하고 다시 분할 트리로 돌아가요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のタイルをワークスペース内で拡大し、その後ツリーを復元します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在工作区内放大已聚焦平铺块，然后恢复分割树。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在工作空間內放大已聚焦並排區塊，然後還原分割樹。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom the focused tile inside its workspace, then restore the tree."
          }
        }
      }
    },
    "Zoom the focused window to fill the workspace. Tatami can keep several windows zoomed at once.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스한 창을 작업 공간에 가득 차도록 확대해요. Tatami는 여러 창의 확대 상태를 동시에 기억할 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のウインドウをワークスペースいっぱいにズームします。Tatamiは複数のウインドウのズーム状態を同時に保持できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将焦点窗口缩放至填满工作区。Tatami 可同时保留多个窗口的缩放状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將焦點視窗縮放至填滿工作空間。Tatami 可同時保留多個視窗的縮放狀態。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom the focused window to fill the workspace. Tatami can keep several windows zoomed at once."
          }
        }
      }
    },
