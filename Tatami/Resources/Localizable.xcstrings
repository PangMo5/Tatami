    "Move backward through the same workspace cycle": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 작업 공간의 전환 순서를 거꾸로 이동해요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じワークスペースの切り替え順を逆方向へ進みます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一工作区的切换顺序中向后移动"
          }
        },
