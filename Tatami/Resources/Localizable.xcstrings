          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将 %@ 置顶到平铺布局上方"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已將 %@ 置頂至並排佈局上方"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept %@ on top of the tiled layout"
          }
        }
      }
    },
