    "Size is the visitor's share of the display; the host receives the remaining space without changing either saved layout.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌려온 작업 공간이 차지할 화면 비율이에요. 저장한 배치는 건드리지 않고 나머지 공간을 호스트가 사용해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズは訪問側が使うディスプレイの割合です。どちらの保存済みレイアウトも変えず、残りをホストが使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大小表示来访工作区占用的显示器比例；主工作区使用剩余空间，双方已保存布局都不会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大小代表來訪工作空間占用的顯示器比例；主工作空間使用剩餘空間，雙方已儲存的佈局都不會改變。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size is the visitor's share of the display; the host receives the remaining space without changing either saved layout."
          }
        }
      }
    },
    "Skip empty workspaces": {
      "localizations": {
