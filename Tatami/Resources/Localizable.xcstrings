    "Nothing changes until you apply the draft.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초안을 적용하기 전까지는 아무것도 바뀌지 않아요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きを適用するまで、実際の設定は変わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用草稿前，不会更改任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用草稿前，不會變更任何內容。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing changes until you apply the draft."
          }
        }
      }
    },
    "Nothing is borrowed on this display": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 디스플레이에는 빌려온 작업 공간이 없어요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このディスプレイで借りているワークスペースはありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此显示器上没有借用的工作区"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台顯示器上沒有借用的工作空間"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Borrowed Workspace on This Display"
          }
        }
      }
    },
    "Nothing outside Guided Setup moves. Watch one window change first, then replace the whole workspace.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가이드 설정 밖의 창은 움직이지 않아요. 먼저 창 하나가 바뀌는 걸 확인한 뒤 작업 공간 전체에 적용해 보세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガイド設定の外にあるウインドウは動きません。まず1つのウインドウの変化を確認してから、ワークスペース全体を置き換えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引导设置之外的任何内容都不会移动。先观察一个窗口的变化，再替换整个工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引導設定以外的任何內容都不會移動。先觀察一個視窗的變化，再取代整個工作空間。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing outside Guided Setup moves. Watch one window change first, then replace the whole workspace."
          }
        }
      }
    },
    "Nothing Selected": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목이 없어요"
          }
        },
        "ja": {
