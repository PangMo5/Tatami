    "Optional. Needed only for Floating mirrors.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이에요. ‘항상 위’ 미러를 쓸 때만 필요해요."
          }
        },
        "ja": {
          "stringUnit": {
