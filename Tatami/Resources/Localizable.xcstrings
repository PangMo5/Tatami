    "Shape the split-tree layout Tatami remembers for each workspace.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatami가 작업 공간마다 기억할 분할 트리 배치를 만들어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatamiがワークスペースごとに記憶する分割ツリーのレイアウトを整えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整 Tatami 为每个工作区记住的分区树布局。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整 Tatami 為每個工作空間記住的分割樹佈局。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shape the split-tree layout Tatami remembers for each workspace."
          }
        }
      }
    },
    "Shared across contexts": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 작업 공간에서 공유"
          }
        },
        "ja": {
          "stringUnit": {
