    "Try the floating shortcut": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘항상 위’ 단축키를 눌러 보세요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「常に手前」のショートカットを試す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用置顶快捷键"
          }
        },
