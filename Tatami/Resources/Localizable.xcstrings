            "state": "translated",
            "value": "No Selection"
          }
        }
      }
    },
    "Nothing shared—recommended": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공용 앱은 없어도 괜찮아요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有なし・推奨"
          }
