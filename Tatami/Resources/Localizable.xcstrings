            "value": "實作並執行一項變更"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Implement and run one change"
          }
        }
      }
    },
    "Include a one-app quick-access context for brief side work": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠깐 쓰는 앱 하나를 위한 빠른 작업 공간도 포함해요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短い作業用に、1アプリだけのクイックアクセス用作業環境を含めます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入一个只放单个应用的快速访问场景，处理临时任务"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入一個只放單一 App 的快速存取工作空間，處理臨時工作"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include a one-app quick-access workspace for brief side work"
          }
        }
      }
    },
    "Inner gap separates neighboring tiles. Outer gap reserves breathing room between the BSP canvas and the display edge.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안쪽 간격은 이웃 타일 사이를 띄워요. 바깥쪽 간격은 BSP 캔버스와 디스플레이 가장자리 사이에 여백을 만들어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内側の間隔は隣り合うタイルを離します。外側の間隔はBSPキャンバスとディスプレイ端の間に余白を作ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内间距分隔相邻的平铺窗口；外间距在 BSP 画布与显示器边缘之间留出空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內間距分隔相鄰的並排視窗；外間距在 BSP 畫布與顯示器邊緣之間留出空間。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inner gap separates neighboring tiles. Outer gap reserves breathing room between the BSP canvas and the display edge."
          }
        }
      }
    },
    "Inner gap: %lld px": {
      "localizations": {
