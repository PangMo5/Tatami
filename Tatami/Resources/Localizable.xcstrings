    "Launch this app automatically when a workspace activates, if it has no open window. Also restores it when minimized.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간을 활성화할 때 열린 창이 없으면 이 앱을 자동으로 실행해요. 최소화된 창도 다시 열어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースの有効化時に開いているウインドウがなければ、このアプリを自動で起動します。最小化中なら復元します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用工作区时，如果此应用没有打开的窗口，则自动启动；窗口最小化时也会恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用工作空間時，若這個 App 沒有開啟的視窗，則自動啟動；視窗最小化時也會還原。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch this app automatically when a workspace activates, if it has no open window. Also restores it when minimized."
          }
        }
      }
    },
    "Launch this app automatically when the workspace activates, if it isn't already running.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간을 활성화할 때 실행 중이 아니면 이 앱을 자동으로 실행해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースの有効化時に実行中でなければ、このアプリを自動で起動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用工作区时，如果此应用尚未运行，则自动启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用工作空間時，若這個 App 尚未執行，則自動啟動。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch this app automatically when the workspace activates, if it isn't already running."
          }
        }
      }
    },
