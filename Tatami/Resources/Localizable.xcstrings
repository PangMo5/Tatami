    "Float + Workspaces": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 위 + 작업 공간"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に手前＋ワークスペース"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "置顶 + 工作区"
          }
        },
