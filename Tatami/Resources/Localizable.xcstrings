    "Badge the windows of a borrowed block with the borrowed workspace's icon, so what's on loan is clear at a glance.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌려온 블록의 창에 해당 작업 공간 아이콘을 표시해요. 어떤 창을 빌려왔는지 바로 알 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "借りたブロックのウインドウに、元のワークスペースのアイコンを表示します。一時表示中のウインドウがひと目で分かります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在借用区块的窗口上显示原工作区图标，方便一眼看出哪些窗口正在借用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在借用區塊的視窗上顯示原工作空間圖示，方便一眼看出哪些視窗正在借用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Badge the windows of a borrowed block with the borrowed workspace's icon, so what's on loan is clear at a glance."
          }
        }
      }
    },
    "Balance": {
      "localizations": {
