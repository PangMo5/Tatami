    "Switching to an app activates the workspace it belongs to.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱으로 전환하면 그 앱이 속한 작업 공간도 함께 활성화돼요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリへ切り替えると、そのアプリが所属するワークスペースも有効になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换到应用时，会启用它所属的工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換至 App 時，會啟用它所屬的工作空間。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching to an app activates the workspace it belongs to."
          }
        }
      }
    },
    "Symlinks `tatami` into /usr/local/bin so you can script Tatami from the terminal — e.g. `tatami activate <workspace>`, `tatami list-workspaces`.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널에서 Tatami를 스크립트로 제어할 수 있도록 `tatami`를 /usr/local/bin에 심볼릭 링크해요. 예: `tatami activate <workspace>`, `tatami list-workspaces`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルからTatamiをスクリプト操作できるよう、`tatami`を/usr/local/binへシンボリックリンクします。例：`tatami activate <workspace>`、`tatami list-workspaces`。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 `tatami` 符号链接到 /usr/local/bin，便于从终端编写脚本控制 Tatami，例如 `tatami activate <workspace>`、`tatami list-workspaces`。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 `tatami` 符號連結至 /usr/local/bin，方便從終端機撰寫 script 控制 Tatami，例如 `tatami activate <workspace>`、`tatami list-workspaces`。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Symlinks `tatami` into /usr/local/bin so you can script Tatami from the terminal — e.g. `tatami activate <workspace>`, `tatami list-workspaces`."
          }
        }
      }
    },
    "Synthesize evidence into one argument": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근거를 하나의 논리로 정리해요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "根拠を1つの主張にまとめる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将依据整合成一个论点"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將依據整合成一個論點"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synthesize evidence into one argument"
          }
        }
      }
    },
    "Tap or drag onto the tiles to restore": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누르거나 타일 위로 드래그해 복원"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックまたはタイルへドラッグして戻す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击或拖到平铺窗口上以恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按或拖至並排視窗上以還原"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap or drag onto the tiles to restore"
          }
        }
      }
    },
    "Tatami": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatami"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatami"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatami"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatami"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatami"
          }
        }
      }
    },
    "Tatami asks only for capabilities used by the features you enable.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatami는 켠 기능에 꼭 필요한 권한만 요청해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatamiは、有効にした機能で使う権限だけを求めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatami 只会请求你所启用功能需要的权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatami 只會要求你所啟用功能需要的權限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatami asks only for capabilities used by the features you enable."
          }
        }
      }
    },
    "tatami CLI": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tatami CLI"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tatami CLI"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
