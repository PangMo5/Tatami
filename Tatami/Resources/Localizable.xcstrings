    "%lld apps assigned — scratchpads work best with exactly one.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 %lld개를 지정했어요. 임시 공간에는 앱 하나만 두는 게 좋아요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld個のアプリが割り当てられています。一時スペースは、アプリを1個だけ置くと使いやすくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已分配 %lld 个应用。暂存区只放一个应用时最好用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已指派 %lld 個 App。暫存區只放一個 App 時最好用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld apps assigned — scratchpads work best with exactly one."
          }
        }
      }
    },
