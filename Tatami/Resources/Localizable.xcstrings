    "Already visible": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 다른 화면에 열려 있어요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに表示されています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在顯示"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already visible"
          }
        }
      }
    },
    "Also matches %@ at the same priority — profile order decides which one activates. Make one more specific, or reorder them in the sidebar.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 우선순위에서 일치하는 프로필이 또 있어요 · %@. 조건을 더 구체적으로 만들거나 사이드바에서 순서를 바꿔 보세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@も同じ優先度で一致します。有効になるプロファイルは並び順で決まります。条件をより具体的にするか、サイドバーで順序を変更してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 也以相同优先级匹配。系统会按配置方案顺序决定启用哪一个。请让其中一个条件更具体，或在边栏中调整顺序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 也會以相同優先順序符合。系統會依設定組合順序決定啟用哪一個。請讓其中一個條件更明確，或在側邊欄調整順序。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also matches %@ at the same priority — profile order decides which one activates. Make one more specific, or reorder them in the sidebar."
          }
        }
      }
    },
    "Always horizontal": {
      "localizations": {
