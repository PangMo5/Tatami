    "Copy each change from “%@” (%@) into this workspace. Uncheck anything you'd rather keep.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Copy each change from “%1$@” (%2$@) into this workspace. Uncheck anything you'd rather keep."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”(%@)의 변경 사항을 이 작업 공간에 복사해요. 지금 설정을 유지할 항목은 선택을 해제하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」（%@）の変更をこのワークスペースへコピーします。現在の設定を残す項目は、チェックを外してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将“%@”（%@）中的各项更改复制到此工作区。若想保留当前设置，请取消勾选对应项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將「%@」（%@）中的各項變更複製到這個工作空間。若想保留目前設定，請取消勾選對應項目。"
          }
        }
      }
    },
    "Copy each change from “%@” into this profile's matching workspaces (by name). Uncheck anything you'd rather keep.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”의 변경 사항을 이 프로필에서 이름이 같은 작업 공간에 복사해요. 지금 설정을 유지할 항목은 선택을 해제하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の変更を、このプロファイル内で名前が一致するワークスペースへコピーします。現在の設定を残す項目は、チェックを外してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将“%@”中的各项更改复制到此配置方案内名称相同的工作区。若想保留当前设置，请取消勾选对应项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將「%@」中的各項變更複製到這個設定組合內名稱相同的工作空間。若想保留目前設定，請取消勾選對應項目。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy each change from “%@” into this profile's matching workspaces (by name). Uncheck anything you'd rather keep."
          }
        }
      }
    },
