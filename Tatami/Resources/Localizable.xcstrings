    "Permissions Needed": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한이 필요해요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限が必要です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
