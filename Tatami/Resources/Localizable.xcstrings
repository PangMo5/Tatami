    "Add the focused app to a named context and follow it there.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스한 앱을 지정한 작업 공간에 추가하고 함께 이동해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のアプリを指定した作業環境へ追加し、そのまま移動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将已聚焦的应用添加到指定场景，并随它一起前往。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將已聚焦的 App 加入指定工作空間，並跟著前往。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the focused app to a named workspace and follow it there."
          }
        }
      }
    },
    "Add the focused app to Shared Apps (tiled into every workspace), or remove it if it's already shared.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스한 앱을 공용 앱에 추가해 모든 작업 공간에 타일로 배치해요. 이미 공용 앱이면 목록에서 빼요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のアプリを共有アプリに追加し、すべてのワークスペースへタイル表示します。すでに共有中なら解除します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将焦点应用加入共享应用，使其平铺在每个工作区中；如果已共享，则将其移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將焦點 App 加入共用 App，讓它並排顯示在每個工作空間中；若已共用，則將它移除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the focused app to Shared Apps (tiled into every workspace), or remove it if it's already shared."
          }
        }
      }
    },
    "Add the focused app to Shared Apps as floating, or flip an existing shared assignment.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스한 앱을 ‘항상 위’ 공용 앱으로 추가하거나 기존 공용 앱의 상태를 전환해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のアプリを「常に手前」の共有アプリとして追加するか、現在の共有設定を切り替えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将焦点应用加入共享应用并保持置顶，或更改现有共享方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將焦點 App 加入共用 App 並保持置頂，或變更現有的共用方式。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the focused app to Shared Apps and keep it on top, or change its current shared behavior."
          }
        }
      }
    },
    "Add the focused app to the active workspace, or remove it if it's already assigned.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스한 앱을 현재 작업 공간에 추가해요. 이미 지정한 앱이면 목록에서 빼요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のアプリを現在のワークスペースに追加します。すでに割り当て済みなら解除します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将焦点应用加入当前工作区；如果已分配，则将其移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將焦點 App 加入目前的工作空間；若已指派，則將它移除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the focused app to the active workspace, or remove it if it's already assigned."
          }
        }
      }
    },
    "Add Workspace": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간 추가"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースを追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加工作区"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入工作空間"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Workspace"
          }
        }
      }
    },
    "Add your role or describe a typical week to guide the draft.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직무나 평소 한 주를 적어주면 초안을 더 잘 만들 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "役割や普段の1週間を入力すると、下書きをより適切に作れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写你的职责或描述平常的一周，帮助生成更合适的草稿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "填寫你的職務或描述平常的一週，幫助產生更合適的草稿。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your role or describe a typical week to guide the draft."
          }
        }
      }
    },
    "Add/remove the focused app in this workspace or in Shared Apps.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스한 앱을 현재 작업 공간이나 공용 앱에 추가하거나 빼요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のアプリを、このワークスペースまたは共有アプリへ追加・削除します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在当前工作区或共享应用中添加或移除已聚焦的应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在目前工作空間或共用 App 中加入或移除已聚焦的 App。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add/remove the focused app in this workspace or in Shared Apps."
          }
        }
      }
    },
    "Added %@ → %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가했어요 · %@ → %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を追加 → %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已添加 %@ → %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已加入 %@ → %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added %@ → %@"
          }
        }
      }
