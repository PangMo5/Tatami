    "More precise contexts; group only apps that always travel together.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간을 세밀하게 나눠요. 항상 함께 쓰는 앱만 한 곳에 묶어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業環境を細かく分け、常に一緒に使うアプリだけをまとめます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "划分更精确的场景，只将总是一起使用的应用归为一组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "劃分更精確的工作空間，只將總是一起使用的 App 歸為一組。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More precise workspaces; group only apps that always travel together."
          }
        }
      }
    },
