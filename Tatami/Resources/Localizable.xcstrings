    },
    "Press again to return the selected app to the BSP tree.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 더 누르면 선택한 앱이 BSP 트리로 돌아가요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度押すと、選択したアプリがBSPツリーへ戻ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次按下可将所选应用放回 BSP 树。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再次按下可將所選 App 放回 BSP 樹。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press again to return the selected app to the BSP tree."
          }
        }
      }
    },
    "Press either shortcut while Guided Setup is open. The virtual display follows the same loop and skip-empty rules as Tatami.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가이드 설정을 연 상태에서 두 단축키 중 하나를 눌러 보세요. 가상 디스플레이도 Tatami처럼 마지막에서 처음으로 이어지고 빈 작업 공간은 건너뛰어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガイド設定を開いたまま、どちらかのショートカットを押してください。仮想ディスプレイもTatamiと同じループ／空を飛ばすルールに従います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在引导设置打开时按任一快捷键。虚拟显示器会遵循与 Tatami 相同的切换和跳过空工作区规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在引導設定開啟時按下任一快速鍵。虛擬顯示器會遵循與 Tatami 相同的切換與略過空白工作空間規則。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press either shortcut while Guided Setup is open. The virtual display follows the same loop and skip-empty rules as Tatami."
          }
        }
      }
    },
    "Press to switch to this profile from anywhere.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서든 이 프로필로 전환할 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこからでもこのプロファイルへ切り替えられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下即可从任意位置切换到此配置方案。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下即可從任何位置切換至這個設定組合。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press to switch to this profile from anywhere."
          }
        }
      }
    },
