    "Hold this key to temporarily pause focus-follows-mouse.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키를 누르고 있는 동안 마우스를 따라 포커스 기능을 잠시 멈춰요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーを押している間、マウスフォーカスを一時停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住此键可暂时停用焦点跟随鼠标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住這個按鍵可暫時停用焦點跟隨滑鼠。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold this key to temporarily pause focus-follows-mouse."
          }
        }
      }
    },
