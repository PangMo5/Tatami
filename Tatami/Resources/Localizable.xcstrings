    "Start Tatami automatically when you log in.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 로그인하면 Tatami를 자동으로 실행해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macへのログイン時にTatamiを自動で起動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 Mac 时自动启动 Tatami。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入 Mac 時自動啟動 Tatami。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Tatami automatically when you log in."
          }
        }
      }
    },
    "Starts pinned to the display you're on. Change this anytime in the workspace's Display section.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 사용 중인 디스플레이에 고정해서 시작해요. 작업 공간의 디스플레이 섹션에서 언제든 바꿀 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のディスプレイに固定して開始します。ワークスペースの「ディスプレイ」セクションでいつでも変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始时会固定到当前显示器。可随时在工作区的“显示器”部分中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始時會固定至目前的顯示器。可隨時在工作空間的「顯示器」區段中變更。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts pinned to the display you're on. Change this anytime in the workspace's Display section."
          }
        }
      }
    },
