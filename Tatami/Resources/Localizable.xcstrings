    "Shared Apps": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공용 앱"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有アプリ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享应用"
          }
        },
