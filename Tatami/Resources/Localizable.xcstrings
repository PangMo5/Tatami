            "state": "translated",
            "value": "設定では、アプリのメタデータとディスプレイ名だけを使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置期间只使用应用元数据和显示器名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定期間只會使用 App 中繼資料與顯示器名稱。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only app metadata and display names are used during setup."
          }
        }
      }
    },
