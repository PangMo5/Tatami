    "Part of the BSP tree. Tatami writes its frame.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BSP 트리에 포함돼요. Tatami가 위치와 크기를 관리해요."
          }
        },
        "ja": {
          "stringUnit": {
