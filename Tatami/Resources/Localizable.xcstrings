    "Overlaps %@ — more specific, so it wins where both match.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조건이 겹치지만 이 프로필이 더 구체적이라 우선해요 · %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@と条件が重なりますが、こちらの方が具体的なため、両方に一致する場合は優先されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 %@ 重叠，但此条件更具体，因此两者同时匹配时由它优先。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與 %@ 重疊，但這個條件更明確，因此兩者同時符合時由它優先。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlaps %@ — more specific, so it wins where both match."
          }
        }
      }
    },
