    "Flip the selected branch between side-by-side and stacked.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 분기를 나란히 배치와 위아래 배치 사이에서 전환해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した分岐を左右配置と上下配置の間で切り替えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在左右排列与上下堆叠之间切换所选分支。"
