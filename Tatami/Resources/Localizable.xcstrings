        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flip the selected branch between side-by-side and stacked."
          }
        }
      }
    },
    "Flip the split between the focused window and its neighbour (side-by-side ↔ stacked).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스한 창과 이웃 창 사이의 분할 방향을 바꿔요(나란히 ↔ 위아래)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のウインドウと隣のウインドウの分割方向を切り替えます（横並び ↔ 縦積み）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻转焦点窗口与相邻窗口之间的分区方向（并排 ↔ 堆叠）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "翻轉焦點視窗與相鄰視窗之間的分割方向（並排 ↔ 上下堆疊）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flip the split between the focused window and its neighbour (side-by-side ↔ stacked)."
          }
        }
      }
    },
