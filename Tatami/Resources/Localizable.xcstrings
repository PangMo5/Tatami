    "Workspaces can follow a named display or stay dynamic.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간을 특정 디스플레이에 고정하거나 포인터를 따라가게 할 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースは、指定したディスプレイに固定するか、動的に追従させられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作区可跟随指定显示器，也可保持动态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作空間可跟隨指定顯示器，也可維持動態。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workspaces can follow a named display or stay dynamic."
          }
        }
      }
    },
    "Wrap from the last workspace back to the first (and vice versa).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 작업 공간 다음에는 처음으로, 처음 이전에는 마지막으로 이어져요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後のワークスペースから先頭へ、先頭から最後へループします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从最后一个工作区继续切换到第一个，反之亦然。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從最後一個工作空間繼續切換至第一個，反之亦然。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrap from the last workspace back to the first (and vice versa)."
          }
        }
      }
    },
