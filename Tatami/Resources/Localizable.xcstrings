    "Routine placement is automatic. Focus, swap, resize, and borrow stay explicit.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소 창 배치는 자동으로 맡기고, 포커스·교체·크기 조절·빌려오기는 직접 실행해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普段の配置は自動で行います。フォーカス、入れ替え、サイズ変更、「借りる」は自分で操作します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日常放置自动完成；焦点、交换、调整大小和借用仍由你明确控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日常放置會自動完成；焦點、交換、調整大小與借用仍由你明確控制。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routine placement is automatic. Focus, swap, resize, and borrow stay explicit."
          }
        }
      }
    },
