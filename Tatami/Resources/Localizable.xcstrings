          }
        }
      }
    },
    "No apps yet. Tap + to assign one.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 앱이 없어요. +를 눌러 앱을 지정해 보세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだアプリがありません。＋ボタンから割り当ててください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有应用。点击 + 分配一个应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有 App。按一下 + 指派一個 App。"
          }
        },
