    "Reload the latest config so no external edit is overwritten.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부에서 수정한 내용을 덮어쓰지 않도록 최신 설정을 다시 불러오세요."
          }
        },
