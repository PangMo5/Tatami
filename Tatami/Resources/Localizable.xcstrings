          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This workspace has no assigned apps yet"
          }
        }
      }
    },
    "This workspace is already active.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 사용 중인 작업 공간이에요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースはすでに有効です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作区已启用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
