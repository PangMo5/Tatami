    "Focus, cycle, swap, resize, split, zoom, and balance all changed only this draft monitor.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스, 전환, 교체, 크기 조절, 분할, 확대, 균등 배치는 모두 이 초안 모니터 안에서만 바뀌었어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス、切り替え、入れ替え、サイズ変更、分割、ズーム、均等化は、すべてこの下書き用ディスプレイ内だけで変更されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "焦点、切换、交换、调整大小、分区、缩放和均衡都只改变了此草稿显示器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "焦點、切換、交換、調整大小、分割、縮放與平衡都只改變了這個草稿顯示器。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus, switch, swap, resize, split, zoom, and balance changed only this draft display."
          }
        }
      }
    },
