{
  "name": "borrow-placement",
  "title": "Choose the edge and the context",
  "summary": "Dock a workspace left or below, cross the boundary with focus, then activate it fully.",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "configure",
      "field": "borrowDefaultEdge",
      "value": "remove"
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "BORROW PLACEMENT"
    },
    {
      "kind": "caption",
      "text": "Choose which edge to place the borrowed workspace on."
    },
    {
      "kind": "saveLayout",
      "text": "home"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - 3"
    },
    {
      "kind": "key",
      "chord": "left"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Chat"
      ]
    },
    {
      "kind": "beat",
      "ms": 1200
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - /"
    },
    {
      "kind": "assertLayout",
      "text": "home"
    },
    {
      "kind": "caption",
      "text": "Borrow can also place a workspace below the current one."
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - 3"
    },
    {
      "kind": "key",
      "chord": "down"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Chat"
      ]
    },
    {
      "kind": "beat",
      "ms": 1100
    },
    {
      "kind": "caption",
      "text": "Activate the borrowed workspace to switch to it completely."
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 3"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Chat"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Chat"
      ]
    },
    {
      "kind": "beat",
      "ms": 1300
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - \\"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Design"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "assertLayout",
      "text": "home"
    },
    {
      "kind": "beat",
      "ms": 1100
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ]
}
