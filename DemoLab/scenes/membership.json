{
  "name": "membership",
  "title": "Move an app with the task",
  "summary": "Move the focused app to a different workspace with a shortcut.",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Editor"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "APP MEMBERSHIP"
    },
    {
      "kind": "caption",
      "text": "Move the focused app to a different workspace with a shortcut."
    },
    {
      "kind": "activateApp",
      "app": "Docs"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - ]"
    },
    {
      "kind": "expectEnabled",
      "app": "Tatami",
      "identifier": "cancel-assignment",
      "enabled": true
    },
    {
      "kind": "caption",
      "text": "Cancel keeps the app in its original workspace."
    },
    {
      "kind": "beat",
      "ms": 1400
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "cancel-assignment",
      "activate": false
    },
    {
      "kind": "expectAssignment",
      "app": "Docs",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "activateApp",
      "app": "Docs"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - ]"
    },
    {
      "kind": "caption",
      "text": "Review the destination, then confirm the move."
    },
    {
      "kind": "expectEnabled",
      "app": "Tatami",
      "identifier": "confirm-assignment",
      "enabled": true
    },
    {
      "kind": "beat",
      "ms": 1400
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "confirm-assignment",
      "activate": false
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Review"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Review",
        "Docs"
      ]
    },
    {
      "kind": "beat",
      "ms": 1400
    },
    {
      "kind": "caption",
      "text": "The moved app is no longer assigned to its original workspace."
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 1"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Write"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor"
      ]
    },
    {
      "kind": "beat",
      "ms": 1600
    },
    {
      "kind": "expectAssignment",
      "app": "Docs",
      "workspace": "Write",
      "profile": "Laptop",
      "present": false
    },
    {
      "kind": "expectAssignment",
      "app": "Docs",
      "workspace": "Review",
      "profile": "Laptop"
    },
    {
      "kind": "beat",
      "ms": 1200
    }
  ],
  "openingApps": [
    "Editor",
    "Docs"
  ]
}
