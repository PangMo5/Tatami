{
  "name": "profiles",
  "title": "Switch the complete setup",
  "summary": "A profile changes the workspace set and restores the arrangement belonging to that context.",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Editor"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "PROFILES"
    },
    {
      "kind": "caption",
      "text": "Change the whole setup in one shortcut."
    },
    {
      "kind": "saveLayout",
      "text": "home"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift + cmd - 2"
    },
    {
      "kind": "waitProfile",
      "profile": "Desk"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas"
      ]
    },
    {
      "kind": "beat",
      "ms": 1700
    },
    {
      "kind": "caption",
      "text": "The original profile remembers its layout."
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift + cmd - 1"
    },
    {
      "kind": "waitProfile",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "assertLayout",
      "text": "home"
    },
    {
      "kind": "beat",
      "ms": 1900
    }
  ],
  "openingApps": [
    "Editor",
    "Docs"
  ]
}
