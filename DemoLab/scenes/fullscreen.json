{
  "name": "fullscreen",
  "title": "Focus with workspace zoom",
  "summary": "Inspect one tile at full workspace size, then return to the exact arrangement.",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "ZOOM & FULLSCREEN"
    },
    {
      "kind": "caption",
      "text": "Enlarge one tile without losing the saved layout."
    },
    {
      "kind": "saveLayout",
      "text": "home"
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - return"
    },
    {
      "kind": "click",
      "app": "Canvas",
      "identifier": "canvas.sand"
    },
    {
      "kind": "beat",
      "ms": 1200
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - return"
    },
    {
      "kind": "assertLayout",
      "text": "home"
    },
    {
      "kind": "caption",
      "text": "Press the shortcut again to restore the previous layout."
    },
    {
      "kind": "beat",
      "ms": 1600
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ]
}
