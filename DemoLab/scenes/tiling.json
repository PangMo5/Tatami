{
  "name": "tiling",
  "title": "Let new windows find their place",
  "summary": "Open a second reference next to the canvas. Close it and the layout reclaims the space.",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "AUTOMATIC TILING"
    },
    {
      "kind": "caption",
      "text": "Open another reference. It finds its place."
    },
    {
      "kind": "activateApp",
      "app": "Docs"
    },
    {
      "kind": "key",
      "chord": "cmd - n"
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "caption",
      "text": "Keep reading without rearranging the desktop."
    },
    {
      "kind": "click",
      "app": "Canvas",
      "identifier": "canvas.forest"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "activateApp",
      "app": "Docs"
    },
    {
      "kind": "key",
      "chord": "cmd - w"
    },
    {
      "kind": "caption",
      "text": "Close it. The remaining windows expand."
    },
    {
      "kind": "beat",
      "ms": 2100
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ]
}
