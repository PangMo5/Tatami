{
  "name": "profile-copy",
  "title": "Reuse an existing setup",
  "summary": "Duplicate a profile in the settings window and review the workspaces to include.",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "prepareSettings"
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "text:Laptop"
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "REUSE A SETUP"
    },
    {
      "kind": "caption",
      "text": "Open Duplicate from a profile’s context menu."
    },
    {
      "kind": "beat",
      "ms": 1400
    },
    {
      "kind": "rightClick",
      "app": "Tatami",
      "identifier": "text:Laptop"
    },
    {
      "kind": "beat",
      "ms": 1100
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "title:Duplicate"
    },
    {
      "kind": "caption",
      "text": "Choose the workspaces and settings to include."
    },
    {
      "kind": "beat",
      "ms": 2600
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "button:Duplicate"
    },
    {
      "kind": "expectProfileCount",
      "count": 3
    },
    {
      "kind": "caption",
      "text": "The new profile can be edited independently."
    },
    {
      "kind": "beat",
      "ms": 2300
    }
  ]
}
