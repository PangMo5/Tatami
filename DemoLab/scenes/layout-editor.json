{
  "name": "layout-editor",
  "title": "Plan a layout visually",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "prepareSettings"
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "text:Design"
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "LAYOUT EDITOR"
    },
    {
      "kind": "caption",
      "text": "Edit the saved layout before activating the workspace."
    },
    {
      "kind": "beat",
      "ms": 1600
    },
    {
      "kind": "saveControlFrame",
      "app": "Tatami",
      "identifier": "text:Canvas",
      "text": "canvas-tile"
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "help:Rotate 90°"
    },
    {
      "kind": "expectControlMoved",
      "app": "Tatami",
      "identifier": "text:Canvas",
      "text": "canvas-tile"
    },
    {
      "kind": "beat",
      "ms": 1400
    },
    {
      "kind": "caption",
      "text": "Flip the top and bottom positions in the layout preview."
    },
    {
      "kind": "beat",
      "ms": 1300
    },
    {
      "kind": "saveControlFrame",
      "app": "Tatami",
      "identifier": "text:Canvas",
      "text": "before-mirror"
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "help:Flip top ↔ bottom"
    },
    {
      "kind": "expectControlMoved",
      "app": "Tatami",
      "identifier": "text:Canvas",
      "text": "before-mirror"
    },
    {
      "kind": "beat",
      "ms": 1300
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "caption",
      "text": "Activating the workspace applies the layout you just edited."
    },
    {
      "kind": "saveControlFrame",
      "app": "Tatami",
      "identifier": "text:Canvas",
      "text": "final-canvas-tile"
    },
    {
      "kind": "closeSettings"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 5"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Design"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "beat",
      "ms": 2100
    },
    {
      "kind": "expectPlacement",
      "app": "Canvas",
      "target": "Docs",
      "value": "above"
    },
    {
      "kind": "beat",
      "ms": 1500
    }
  ],
  "summary": "Edit the saved layout before activating the workspace."
}
