{
  "name": "drag",
  "title": "用鼠标排列",
  "summary": "拖移窗口、调整边缘，再恢复保存的布局。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "拖移与调整大小"
    },
    {
      "kind": "caption",
      "text": "将窗口拖到另一个窗口上，交换位置或插入布局。"
    },
    {
      "kind": "saveLayout",
      "text": "home"
    },
    {
      "kind": "dragWindow",
      "app": "Canvas",
      "target": "Docs",
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "expectLayoutChanged",
      "text": "home"
    },
    {
      "kind": "beat",
      "ms": 1400
    },
    {
      "kind": "caption",
      "text": "拖动窗口边缘，Tatami 会保存新的分割比例。"
    },
    {
      "kind": "resizeWindow",
      "app": "Canvas",
      "x": 140
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "saveLayout",
      "text": "resized"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 3"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Chat"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Chat"
      ]
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 5"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Design"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "assertLayout",
      "text": "resized"
    },
    {
      "kind": "beat",
      "ms": 1500
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ]
}
