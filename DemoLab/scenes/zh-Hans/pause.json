{
  "name": "pause",
  "title": "手动控制布局",
  "summary": "暂停自动平铺，自由摆放窗口，再恢复整理好的工作区。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "暂停与恢复"
    },
    {
      "kind": "caption",
      "text": "需要自由摆放时，暂停平铺。"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift + cmd - z"
    },
    {
      "kind": "saveLayout",
      "text": "home"
    },
    {
      "kind": "dragWindow",
      "app": "Docs",
      "target": "Canvas",
      "x": 0.65,
      "y": 0.35
    },
    {
      "kind": "expectLayoutChanged",
      "text": "home"
    },
    {
      "kind": "beat",
      "ms": 1500
    },
    {
      "kind": "caption",
      "text": "恢复后，Tatami 会重新排列窗口。"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift + cmd - z"
    },
    {
      "kind": "beat",
      "ms": 1900
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - e"
    },
    {
      "kind": "beat",
      "ms": 1200
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ]
}
