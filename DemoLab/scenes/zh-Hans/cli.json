{
  "name": "cli",
  "title": "用 CLI 准备专注环境",
  "summary": "查看实际工作区列表，再运行包含激活、均衡布局和借用操作的脚本。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Build",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Terminal"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Terminal"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "命令行"
    },
    {
      "kind": "caption",
      "text": "通过 CLI 查看工作区列表并控制正在运行的 Tatami。"
    },
    {
      "kind": "click",
      "app": "Terminal",
      "identifier": "terminal.command"
    },
    {
      "kind": "typeText",
      "app": "Terminal",
      "text": "tatami workspace list",
      "ms": 65
    },
    {
      "kind": "key",
      "chord": "return"
    },
    {
      "kind": "expectCommand",
      "text": "tatami workspace list",
      "code": 0
    },
    {
      "kind": "beat",
      "ms": 1600
    },
    {
      "kind": "caption",
      "text": "一个脚本即可切换、排列和借用工作区。"
    },
    {
      "kind": "click",
      "app": "Terminal",
      "identifier": "terminal.command"
    },
    {
      "kind": "typeText",
      "app": "Terminal",
      "text": "focus-session",
      "ms": 65
    },
    {
      "kind": "key",
      "chord": "return"
    },
    {
      "kind": "expectCommand",
      "text": "focus-session",
      "code": 0
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs",
        "Notes"
      ]
    },
    {
      "kind": "expectHook",
      "field": "workspace",
      "value": "Design"
    },
    {
      "kind": "beat",
      "ms": 2000
    }
  ],
  "openingApps": [
    "Terminal"
  ]
}
