{
  "name": "borrow-placement",
  "title": "选择位置和工作环境",
  "summary": "把工作区借到左侧或下方，跨过边界移动焦点，再完整切换过去。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "configure",
      "field": "borrowDefaultEdge",
      "value": "remove"
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "选择借用位置"
    },
    {
      "kind": "caption",
      "text": "选择将借用的工作区放在屏幕的哪一侧。"
    },
    {
      "kind": "saveLayout",
      "text": "home"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - 3"
    },
    {
      "kind": "key",
      "chord": "left"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Chat"
      ]
    },
    {
      "kind": "beat",
      "ms": 1200
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - /"
    },
    {
      "kind": "assertLayout",
      "text": "home"
    },
    {
      "kind": "caption",
      "text": "也可以把借用的工作区放在当前工作区下方。"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - 3"
    },
    {
      "kind": "key",
      "chord": "down"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Chat"
      ]
    },
    {
      "kind": "beat",
      "ms": 1100
    },
    {
      "kind": "caption",
      "text": "激活借用的工作区，就会完全切换过去。"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 3"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Chat"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Chat"
      ]
    },
    {
      "kind": "beat",
      "ms": 1300
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - \\"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Design"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "assertLayout",
      "text": "home"
    },
    {
      "kind": "beat",
      "ms": 1100
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ]
}
