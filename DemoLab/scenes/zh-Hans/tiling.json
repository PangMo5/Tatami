{
  "name": "tiling",
  "title": "让新窗口找到位置",
  "summary": "新窗口会分割当前选中窗口的区域，自动排列。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - left"
    },
    {
      "kind": "beat",
      "ms": 700
    },
    {
      "kind": "expectPlacement",
      "app": "Docs",
      "target": "Canvas",
      "value": "right"
    },
    {
      "kind": "activateApp",
      "app": "Docs"
    },
    {
      "kind": "beat",
      "ms": 700
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "自动平铺"
    },
    {
      "kind": "caption",
      "text": "新窗口会分割当前选中窗口的区域，自动排列。"
    },
    {
      "kind": "beat",
      "ms": 1300
    },
    {
      "kind": "activateApp",
      "app": "Docs"
    },
    {
      "kind": "expectFront",
      "app": "Docs"
    },
    {
      "kind": "beat",
      "ms": 600
    },
    {
      "kind": "key",
      "chord": "cmd - n"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs",
        "Docs"
      ]
    },
    {
      "kind": "expectPlacement",
      "app": "Docs",
      "target": "Canvas",
      "value": "right"
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "caption",
      "text": "新窗口加入时，其他区域的窗口保持原位。"
    },
    {
      "kind": "click",
      "app": "Canvas",
      "identifier": "canvas.forest"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "activateApp",
      "app": "Docs"
    },
    {
      "kind": "key",
      "chord": "cmd - w"
    },
    {
      "kind": "caption",
      "text": "关闭窗口后，其余窗口会填满腾出的空间。"
    },
    {
      "kind": "beat",
      "ms": 2100
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ]
}
