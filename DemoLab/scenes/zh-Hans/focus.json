{
  "name": "focus",
  "title": "让焦点跟随你的意图",
  "summary": "用快捷键选择相邻窗口并移动鼠标指针，也可以将指针移入窗口来选中它。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "焦点与指针"
    },
    {
      "kind": "caption",
      "text": "用快捷键选中窗口时，鼠标指针也会移到该窗口。"
    },
    {
      "kind": "beat",
      "ms": 1500
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - h"
    },
    {
      "kind": "expectFront",
      "app": "Docs"
    },
    {
      "kind": "expectPointer",
      "app": "Docs"
    },
    {
      "kind": "beat",
      "ms": 900
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - l"
    },
    {
      "kind": "expectFront",
      "app": "Canvas"
    },
    {
      "kind": "expectPointer",
      "app": "Canvas"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - h"
    },
    {
      "kind": "expectFront",
      "app": "Docs"
    },
    {
      "kind": "expectPointer",
      "app": "Docs"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - l"
    },
    {
      "kind": "expectFront",
      "app": "Canvas"
    },
    {
      "kind": "expectPointer",
      "app": "Canvas"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "caption",
      "text": "启用焦点跟随鼠标后，指针移入哪个窗口就选中哪个窗口。"
    },
    {
      "kind": "hover",
      "app": "Canvas",
      "identifier": "canvas.sand"
    },
    {
      "kind": "expectFront",
      "app": "Canvas"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "hover",
      "app": "Docs",
      "identifier": "docs.search"
    },
    {
      "kind": "expectFront",
      "app": "Docs"
    },
    {
      "kind": "typeText",
      "app": "Docs",
      "text": "标题",
      "ms": 65
    },
    {
      "kind": "expectValue",
      "app": "Docs",
      "identifier": "docs.search",
      "value": "标题"
    },
    {
      "kind": "beat",
      "ms": 1300
    },
    {
      "kind": "caption",
      "text": "关闭窗口后，自动选中剩下的窗口。"
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "key",
      "chord": "cmd - w"
    },
    {
      "kind": "expectFront",
      "app": "Docs"
    },
    {
      "kind": "beat",
      "ms": 1700
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ]
}
