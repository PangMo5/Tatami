{
  "name": "layouts",
  "title": "用键盘调整布局",
  "summary": "交换窗口、改变分割方向、调整大小，再均衡整个布局。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "appWindows",
      "app": "Docs",
      "count": 2
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Docs",
        "Canvas"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "beat",
      "ms": 700
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "布局控制"
    },
    {
      "kind": "caption",
      "text": "交换当前选中窗口与相邻窗口的位置。"
    },
    {
      "kind": "beat",
      "ms": 1300
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "saveLayout",
      "text": "home"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - left"
    },
    {
      "kind": "expectLayoutChanged",
      "text": "home"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "caption",
      "text": "在左右分割和上下分割之间切换。"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - s"
    },
    {
      "kind": "beat",
      "ms": 1500
    },
    {
      "kind": "caption",
      "text": "扩大当前选中窗口所占的区域。"
    },
    {
      "kind": "saveLayout",
      "text": "before-grow"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - =",
      "repeats": 3
    },
    {
      "kind": "expectLayoutChanged",
      "text": "before-grow"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "caption",
      "text": "关闭自动均衡时，均衡命令会恢复默认 BSP 布局。"
    },
    {
      "kind": "saveLayout",
      "text": "before-balance"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - e"
    },
    {
      "kind": "expectLayoutChanged",
      "text": "before-balance"
    },
    {
      "kind": "beat",
      "ms": 2000
    }
  ],
  "openingApps": [
    "Docs",
    "Docs",
    "Canvas"
  ]
}
