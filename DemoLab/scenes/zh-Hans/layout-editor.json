{
  "name": "layout-editor",
  "title": "直观规划布局",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "prepareSettings"
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "text:Design"
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "布局编辑器"
    },
    {
      "kind": "caption",
      "text": "激活工作区之前，先编辑保存的窗口布局。"
    },
    {
      "kind": "beat",
      "ms": 1600
    },
    {
      "kind": "saveControlFrame",
      "app": "Tatami",
      "identifier": "text:Canvas",
      "text": "canvas-tile"
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "help:旋转 90°"
    },
    {
      "kind": "expectControlMoved",
      "app": "Tatami",
      "identifier": "text:Canvas",
      "text": "canvas-tile"
    },
    {
      "kind": "beat",
      "ms": 1400
    },
    {
      "kind": "caption",
      "text": "在布局预览中交换上下位置。"
    },
    {
      "kind": "beat",
      "ms": 1300
    },
    {
      "kind": "saveControlFrame",
      "app": "Tatami",
      "identifier": "text:Canvas",
      "text": "before-mirror"
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "help:上下翻转"
    },
    {
      "kind": "expectControlMoved",
      "app": "Tatami",
      "identifier": "text:Canvas",
      "text": "before-mirror"
    },
    {
      "kind": "beat",
      "ms": 1300
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "caption",
      "text": "激活工作区后，刚才编辑的布局会应用到实际窗口。"
    },
    {
      "kind": "saveControlFrame",
      "app": "Tatami",
      "identifier": "text:Canvas",
      "text": "final-canvas-tile"
    },
    {
      "kind": "closeSettings"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 5"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Design"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "beat",
      "ms": 2100
    },
    {
      "kind": "expectPlacement",
      "app": "Canvas",
      "target": "Docs",
      "value": "above"
    },
    {
      "kind": "beat",
      "ms": 1500
    }
  ],
  "summary": "激活工作区之前，先编辑保存的窗口布局。"
}
