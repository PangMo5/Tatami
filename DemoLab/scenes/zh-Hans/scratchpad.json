{
  "name": "scratchpad",
  "title": "随时调出的暂存区",
  "summary": "再次借用时，应用中的内容仍然保留。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "暂存区"
    },
    {
      "kind": "caption",
      "text": "临时工作区只在借用时打开。"
    },
    {
      "kind": "saveLayout",
      "text": "home"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - n"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Notes"
      ]
    },
    {
      "kind": "click",
      "app": "Notes",
      "identifier": "notes.newTask"
    },
    {
      "kind": "typeText",
      "app": "Notes",
      "text": "比较三种配色方向。",
      "ms": 65
    },
    {
      "kind": "key",
      "chord": "return"
    },
    {
      "kind": "expectStory",
      "field": "lastTask",
      "value": "比较三种配色方向。"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - /"
    },
    {
      "kind": "assertLayout",
      "text": "home"
    },
    {
      "kind": "caption",
      "text": "再次借用时，应用中的内容仍然保留。"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - n"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Notes"
      ]
    },
    {
      "kind": "expectStory",
      "field": "lastTask",
      "value": "比较三种配色方向。"
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - /"
    },
    {
      "kind": "assertLayout",
      "text": "home"
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ]
}
