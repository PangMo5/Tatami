{
  "name": "unmanaged",
  "title": "让窗口留在原处",
  "summary": "让共享应用保持普通堆叠顺序，跨任务保留窗口的位置和大小。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "launch",
      "apps": [
        "Monitor"
      ]
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Monitor"
      ]
    },
    {
      "kind": "beat",
      "ms": 700
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "保持原样"
    },
    {
      "kind": "caption",
      "text": "设为保持原样的窗口不参与自动平铺。"
    },
    {
      "kind": "dragWindow",
      "app": "Monitor",
      "target": "Canvas",
      "x": 0.8,
      "y": 0.22
    },
    {
      "kind": "saveWindow",
      "app": "Monitor"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "caption",
      "text": "设为共享应用后，切换工作区也会保持它的位置和大小。"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 2"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Review"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Review",
        "Docs"
      ]
    },
    {
      "kind": "assertWindow",
      "app": "Monitor"
    },
    {
      "kind": "hold",
      "modifiers": "alt",
      "keys": [
        "tab"
      ],
      "gapMs": 800,
      "releaseAfterMs": 1200
    },
    {
      "kind": "expectFront",
      "app": "Monitor"
    },
    {
      "kind": "beat",
      "ms": 1400
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 5"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Design"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "assertWindow",
      "app": "Monitor"
    },
    {
      "kind": "hold",
      "modifiers": "alt",
      "keys": [
        "tab"
      ],
      "gapMs": 800,
      "releaseAfterMs": 1200
    },
    {
      "kind": "expectFront",
      "app": "Monitor"
    },
    {
      "kind": "beat",
      "ms": 1500
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs",
    "Monitor"
  ]
}
