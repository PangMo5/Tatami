{
  "name" : "floating",
  "requires" : {
    "displays" : 1
  },
  "setup" : [
    {
      "kind" : "clearOverlay"
    },
    {
      "display" : 0,
      "kind" : "pointer",
      "x" : 0.5,
      "y" : 0.5
    },
    {
      "kind" : "activateWorkspace",
      "profile" : "Laptop",
      "workspace" : "Write"
    },
    {
      "apps" : [
        "Editor",
        "Docs"
      ],
      "kind" : "waitWindows"
    },
    {
      "kind" : "activateWorkspace",
      "profile" : "Laptop",
      "workspace" : "Focus"
    },
    {
      "apps" : [
        "Canvas",
        "Notes"
      ],
      "kind" : "waitWindows"
    },
    {
      "app" : "Canvas",
      "kind" : "activateApp"
    },
    {
      "args" : [
        "layout",
        "balance"
      ],
      "kind" : "cli"
    },
    {
      "kind" : "beat",
      "ms" : 1800
    }
  ],
  "steps" : [
    {
      "kind" : "chapter",
      "text" : "常に手前"
    },
    {
      "kind" : "caption",
      "text" : "最前面表示にしたウインドウは、ワークスペースの手前に表示されます。"
    },
    {
      "activate" : false,
      "app" : "Notes",
      "identifier" : "notes.newTask",
      "kind" : "click"
    },
    {
      "app" : "Notes",
      "kind" : "typeText",
      "ms" : 65,
      "text" : "小さいサイズでもプレビューを確認します。"
    },
    {
      "chord" : "return",
      "kind" : "key"
    },
    {
      "field" : "lastTask",
      "kind" : "expectStory",
      "value" : "小さいサイズでもプレビューを確認します。"
    },
    {
      "app" : "Notes",
      "kind" : "saveWindow"
    },
    {
      "kind" : "beat",
      "ms" : 1200
    },
    {
      "kind" : "caption",
      "text" : "タイル表示に切り替えると、ほかのウインドウと並んで配置されます。"
    },
    {
      "app" : "Notes",
      "kind" : "activateApp"
    },
    {
      "chord" : "alt + cmd - return",
      "kind" : "key"
    },
    {
      "app" : "Tatami",
      "enabled" : true,
      "identifier" : "confirm-assignment",
      "kind" : "expectEnabled"
    },
    {
      "kind" : "beat",
      "ms" : 1400
    },
    {
      "activate" : false,
      "app" : "Tatami",
      "identifier" : "confirm-assignment",
      "kind" : "click"
    },
    {
      "app" : "Notes",
      "kind" : "expectAssignment",
      "layout" : "tiled",
      "profile" : "Laptop",
      "workspace" : "Focus"
    },
    {
      "kind" : "beat",
      "ms" : 1600
    },
    {
      "kind" : "caption",
      "text" : "必要なときに、再び最前面表示へ戻せます。"
    },
    {
      "chord" : "alt + cmd - return",
      "kind" : "key"
    },
    {
      "app" : "Tatami",
      "enabled" : true,
      "identifier" : "confirm-assignment",
      "kind" : "expectEnabled"
    },
    {
      "kind" : "beat",
      "ms" : 1400
    },
    {
      "activate" : false,
      "app" : "Tatami",
      "identifier" : "confirm-assignment",
      "kind" : "click"
    },
    {
      "app" : "Notes",
      "kind" : "expectAssignment",
      "layout" : "floating",
      "profile" : "Laptop",
      "workspace" : "Focus"
    },
    {
      "kind" : "beat",
      "ms" : 400
    },
    {
      "app" : "Notes",
      "kind" : "restoreWindow"
    },
    {
      "app" : "Notes",
      "kind" : "assertWindow"
    },
    {
      "kind" : "beat",
      "ms" : 1100
    },
    {
      "app" : "Canvas",
      "kind" : "activateApp"
    },
    {
      "kind" : "beat",
      "ms" : 1100
    },
    {
      "app" : "Notes",
      "kind" : "assertWindow"
    }
  ],
  "summary" : "メモを常に手前に置いたりタイル表示に戻したりしながら、実際のボタンや入力欄を使います。",
  "title" : "ワークスペースの手前にメモを置く"
}
