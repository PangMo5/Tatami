{
  "name": "focus",
  "title": "意図に合わせてフォーカスを移す",
  "summary": "ショートカットで隣のウインドウを選び、ポインタも移動します。マウスを重ねて選ぶ方法も紹介します。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "フォーカスとポインタ"
    },
    {
      "kind": "caption",
      "text": "ショートカットでウインドウを選ぶと、ポインタもそのウインドウへ移動します。"
    },
    {
      "kind": "beat",
      "ms": 1500
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - h"
    },
    {
      "kind": "expectFront",
      "app": "Docs"
    },
    {
      "kind": "expectPointer",
      "app": "Docs"
    },
    {
      "kind": "beat",
      "ms": 900
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - l"
    },
    {
      "kind": "expectFront",
      "app": "Canvas"
    },
    {
      "kind": "expectPointer",
      "app": "Canvas"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - h"
    },
    {
      "kind": "expectFront",
      "app": "Docs"
    },
    {
      "kind": "expectPointer",
      "app": "Docs"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - l"
    },
    {
      "kind": "expectFront",
      "app": "Canvas"
    },
    {
      "kind": "expectPointer",
      "app": "Canvas"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "caption",
      "text": "ポインタを重ねたウインドウが自動で選ばれる設定もあります。"
    },
    {
      "kind": "hover",
      "app": "Canvas",
      "identifier": "canvas.sand"
    },
    {
      "kind": "expectFront",
      "app": "Canvas"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "hover",
      "app": "Docs",
      "identifier": "docs.search"
    },
    {
      "kind": "expectFront",
      "app": "Docs"
    },
    {
      "kind": "typeText",
      "app": "Docs",
      "text": "見出し",
      "ms": 65
    },
    {
      "kind": "expectValue",
      "app": "Docs",
      "identifier": "docs.search",
      "value": "見出し"
    },
    {
      "kind": "beat",
      "ms": 1300
    },
    {
      "kind": "caption",
      "text": "ウインドウを閉じると、残っているウインドウへフォーカスが移ります。"
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "key",
      "chord": "cmd - w"
    },
    {
      "kind": "expectFront",
      "app": "Docs"
    },
    {
      "kind": "beat",
      "ms": 1700
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ]
}
