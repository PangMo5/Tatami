{
  "name": "membership",
  "title": "作業に合わせてアプリを移す",
  "summary": "ショートカットで、選択中のアプリを別のワークスペースへ移します。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Editor"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "アプリの割り当て"
    },
    {
      "kind": "caption",
      "text": "ショートカットで、選択中のアプリを別のワークスペースへ移します。"
    },
    {
      "kind": "activateApp",
      "app": "Docs"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - ]"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Review"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Review",
        "Docs"
      ]
    },
    {
      "kind": "beat",
      "ms": 1400
    },
    {
      "kind": "caption",
      "text": "移したアプリは、元のワークスペースから外れます。"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 1"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Write"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor"
      ]
    },
    {
      "kind": "beat",
      "ms": 1600
    },
    {
      "kind": "caption",
      "text": "同じ操作で、アプリを元のワークスペースへ戻せます。"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 2"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Review"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Review",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Docs"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - ["
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Write"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "beat",
      "ms": 1600
    }
  ],
  "openingApps": [
    "Editor",
    "Docs"
  ]
}
