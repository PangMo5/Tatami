{
  "name" : "membership",
  "openingApps" : [
    "Editor",
    "Docs"
  ],
  "requires" : {
    "displays" : 1
  },
  "setup" : [
    {
      "kind" : "clearOverlay"
    },
    {
      "display" : 0,
      "kind" : "pointer",
      "x" : 0.5,
      "y" : 0.5
    },
    {
      "kind" : "activateWorkspace",
      "profile" : "Laptop",
      "workspace" : "Write"
    },
    {
      "apps" : [
        "Editor",
        "Docs"
      ],
      "kind" : "waitWindows"
    },
    {
      "kind" : "activateWorkspace",
      "profile" : "Laptop",
      "workspace" : "Write"
    },
    {
      "apps" : [
        "Editor",
        "Docs"
      ],
      "kind" : "waitWindows"
    },
    {
      "app" : "Editor",
      "kind" : "activateApp"
    },
    {
      "args" : [
        "layout",
        "balance"
      ],
      "kind" : "cli"
    },
    {
      "kind" : "beat",
      "ms" : 1800
    }
  ],
  "steps" : [
    {
      "kind" : "chapter",
      "text" : "アプリの割り当て"
    },
    {
      "kind" : "caption",
      "text" : "ショートカットで、選択中のアプリを別のワークスペースへ移します。"
    },
    {
      "app" : "Docs",
      "kind" : "activateApp"
    },
    {
      "chord" : "ctrl + alt + shift - ]",
      "kind" : "key"
    },
    {
      "app" : "Tatami",
      "enabled" : true,
      "identifier" : "cancel-assignment",
      "kind" : "expectEnabled"
    },
    {
      "kind" : "caption",
      "text" : "キャンセルすると、アプリは元のワークスペースに残ります。"
    },
    {
      "kind" : "beat",
      "ms" : 1400
    },
    {
      "activate" : false,
      "app" : "Tatami",
      "identifier" : "cancel-assignment",
      "kind" : "click"
    },
    {
      "app" : "Docs",
      "kind" : "expectAssignment",
      "profile" : "Laptop",
      "workspace" : "Write"
    },
    {
      "app" : "Docs",
      "kind" : "activateApp"
    },
    {
      "chord" : "ctrl + alt + shift - ]",
      "kind" : "key"
    },
    {
      "kind" : "caption",
      "text" : "移動先を確認してから、移動を確定します。"
    },
    {
      "app" : "Tatami",
      "enabled" : true,
      "identifier" : "confirm-assignment",
      "kind" : "expectEnabled"
    },
    {
      "kind" : "beat",
      "ms" : 1400
    },
    {
      "activate" : false,
      "app" : "Tatami",
      "identifier" : "confirm-assignment",
      "kind" : "click"
    },
    {
      "kind" : "waitWorkspace",
      "workspace" : "Review"
    },
    {
      "apps" : [
        "Review",
        "Docs"
      ],
      "kind" : "waitWindows"
    },
    {
      "kind" : "beat",
      "ms" : 1400
    },
    {
      "kind" : "caption",
      "text" : "移したアプリは、元のワークスペースから外れます。"
    },
    {
      "chord" : "ctrl + alt + shift - 1",
      "kind" : "key"
    },
    {
      "kind" : "waitWorkspace",
      "workspace" : "Write"
    },
    {
      "apps" : [
        "Editor"
      ],
      "kind" : "waitWindows"
    },
    {
      "kind" : "beat",
      "ms" : 1600
    },
    {
      "app" : "Docs",
      "kind" : "expectAssignment",
      "present" : false,
      "profile" : "Laptop",
      "workspace" : "Write"
    },
    {
      "app" : "Docs",
      "kind" : "expectAssignment",
      "profile" : "Laptop",
      "workspace" : "Review"
    },
    {
      "kind" : "beat",
      "ms" : 1200
    }
  ],
  "summary" : "ショートカットで、選択中のアプリを別のワークスペースへ移します。",
  "title" : "作業に合わせてアプリを移す"
}
