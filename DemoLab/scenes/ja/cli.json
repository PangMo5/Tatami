{
  "name": "cli",
  "title": "CLI で集中できる環境を用意する",
  "summary": "実際のワークスペース一覧を確認し、切り替え・均等配置・借りる操作をまとめたスクリプトを実行します。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Build",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Terminal"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Terminal"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "コマンドライン"
    },
    {
      "kind": "caption",
      "text": "CLI からワークスペース一覧を確認し、起動中の Tatami を操作できます。"
    },
    {
      "kind": "click",
      "app": "Terminal",
      "identifier": "terminal.command"
    },
    {
      "kind": "typeText",
      "app": "Terminal",
      "text": "tatami workspace list",
      "ms": 65
    },
    {
      "kind": "key",
      "chord": "return"
    },
    {
      "kind": "expectCommand",
      "text": "tatami workspace list",
      "code": 0
    },
    {
      "kind": "beat",
      "ms": 1600
    },
    {
      "kind": "caption",
      "text": "一つのスクリプトで、ワークスペースの切り替え・配置・借用を実行します。"
    },
    {
      "kind": "click",
      "app": "Terminal",
      "identifier": "terminal.command"
    },
    {
      "kind": "typeText",
      "app": "Terminal",
      "text": "focus-session",
      "ms": 65
    },
    {
      "kind": "key",
      "chord": "return"
    },
    {
      "kind": "expectCommand",
      "text": "focus-session",
      "code": 0
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs",
        "Notes"
      ]
    },
    {
      "kind": "expectHook",
      "field": "workspace",
      "value": "Design"
    },
    {
      "kind": "beat",
      "ms": 2000
    }
  ],
  "openingApps": [
    "Terminal"
  ]
}
