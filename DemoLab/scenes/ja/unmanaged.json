{
  "name": "unmanaged",
  "title": "置いた場所にウインドウを残す",
  "summary": "共有アプリを通常の重なり順にすると、作業が変わっても位置と大きさが保たれます。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "launch",
      "apps": [
        "Monitor"
      ]
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Monitor"
      ]
    },
    {
      "kind": "beat",
      "ms": 700
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "そのまま"
    },
    {
      "kind": "caption",
      "text": "そのまま表示にしたウインドウは、自動タイル配置の対象外になります。"
    },
    {
      "kind": "dragWindow",
      "app": "Monitor",
      "target": "Canvas",
      "x": 0.8,
      "y": 0.22
    },
    {
      "kind": "saveWindow",
      "app": "Monitor"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "caption",
      "text": "共有アプリにすると、ワークスペースを変えても位置と大きさを保てます。"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 2"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Review"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Review",
        "Docs"
      ]
    },
    {
      "kind": "assertWindow",
      "app": "Monitor"
    },
    {
      "kind": "hold",
      "modifiers": "alt",
      "keys": [
        "tab"
      ],
      "gapMs": 800,
      "releaseAfterMs": 1200
    },
    {
      "kind": "expectFront",
      "app": "Monitor"
    },
    {
      "kind": "beat",
      "ms": 1400
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 5"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Design"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "assertWindow",
      "app": "Monitor"
    },
    {
      "kind": "hold",
      "modifiers": "alt",
      "keys": [
        "tab"
      ],
      "gapMs": 800,
      "releaseAfterMs": 1200
    },
    {
      "kind": "expectFront",
      "app": "Monitor"
    },
    {
      "kind": "beat",
      "ms": 1500
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs",
    "Monitor"
  ]
}
