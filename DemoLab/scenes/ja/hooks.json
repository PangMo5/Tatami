{
  "name": "hooks",
  "title": "ワークスペースの切り替えをほかのツールに届ける",
  "summary": "ワークスペースが変わると、フックで外部ツールに通知できます。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "launch",
      "apps": [
        "Monitor"
      ]
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Monitor"
      ]
    },
    {
      "kind": "beat",
      "ms": 700
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "状態と操作フィードバックのフック"
    },
    {
      "kind": "caption",
      "text": "ワークスペースが変わると、フックで外部ツールに通知できます。"
    },
    {
      "kind": "click",
      "app": "Monitor",
      "identifier": "monitor.mode"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 3"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Chat"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Chat"
      ]
    },
    {
      "kind": "expectHook",
      "field": "workspace",
      "value": "Chat"
    },
    {
      "kind": "beat",
      "ms": 1200
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 5"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Design"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "expectHook",
      "field": "workspace",
      "value": "Design"
    },
    {
      "kind": "caption",
      "text": "HUD フックを使うと、操作結果の通知も外部ツールへ送れます。"
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - return"
    },
    {
      "kind": "beat",
      "ms": 1700
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - return"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - n"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Notes"
      ]
    },
    {
      "kind": "beat",
      "ms": 1500
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - /"
    },
    {
      "kind": "beat",
      "ms": 1200
    }
  ]
}
