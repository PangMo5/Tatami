{
  "name" : "scratchpad",
  "openingApps" : [
    "Canvas",
    "Docs"
  ],
  "requires" : {
    "displays" : 2
  },
  "setup" : [
    {
      "display" : 0,
      "kind" : "pointer",
      "x" : 0.5,
      "y" : 0.5
    },
    {
      "kind" : "activateWorkspace",
      "profile" : "Desk",
      "workspace" : "Design"
    },
    {
      "apps" : [
        "Canvas",
        "Docs"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "kind" : "saveLayout",
      "text" : "hosts"
    }
  ],
  "steps" : [
    {
      "kind" : "chapter",
      "text" : "一時スペース"
    },
    {
      "kind" : "caption",
      "text" : "スクラッチパッドは、借りる操作でのみ表示できます。"
    },
    {
      "chord" : "ctrl + alt + cmd - n",
      "kind" : "key"
    },
    {
      "apps" : [
        "Canvas",
        "Docs",
        "Notes"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "app" : "Notes",
      "identifier" : "notes.newTask",
      "kind" : "click"
    },
    {
      "app" : "Notes",
      "kind" : "typeText",
      "ms" : 45,
      "text" : "3 つの配色を比べます。"
    },
    {
      "chord" : "return",
      "kind" : "key"
    },
    {
      "field" : "lastTask",
      "kind" : "expectStory",
      "value" : "3 つの配色を比べます。"
    },
    {
      "kind" : "caption",
      "text" : "ポインタを別の画面へ動かし、同じショートカットを押します。"
    },
    {
      "app" : "Docs",
      "identifier" : "docs.search",
      "kind" : "hover",
      "ms" : 1400
    },
    {
      "kind" : "beat",
      "ms" : 700
    },
    {
      "chord" : "ctrl + alt + cmd - n",
      "kind" : "key"
    },
    {
      "app" : "Notes",
      "kind" : "expectPlacement",
      "target" : "Docs",
      "value" : "right"
    },
    {
      "app" : "Notes",
      "kind" : "expectPointerCentered"
    },
    {
      "kind" : "caption",
      "text" : "同じメモがこちらへ移動し、元のワークスペースは配置が戻ります。"
    },
    {
      "field" : "lastTask",
      "kind" : "expectStory",
      "value" : "3 つの配色を比べます。"
    },
    {
      "kind" : "beat",
      "ms" : 1800
    },
    {
      "app" : "Canvas",
      "identifier" : "canvas.sand",
      "kind" : "hover",
      "ms" : 1400
    },
    {
      "kind" : "beat",
      "ms" : 700
    },
    {
      "chord" : "ctrl + alt + cmd - n",
      "kind" : "key"
    },
    {
      "app" : "Notes",
      "kind" : "expectPlacement",
      "target" : "Docs",
      "value" : "left"
    },
    {
      "field" : "lastTask",
      "kind" : "expectStory",
      "value" : "3 つの配色を比べます。"
    },
    {
      "kind" : "beat",
      "ms" : 1800
    },
    {
      "chord" : "ctrl + alt + cmd - /",
      "kind" : "key"
    },
    {
      "apps" : [
        "Canvas",
        "Docs"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "kind" : "assertLayout",
      "text" : "hosts"
    },
    {
      "kind" : "beat",
      "ms" : 1000
    }
  ],
  "summary" : "同じショートカットで、メモの内容を保ったまま別の画面へ移せます。",
  "title" : "何度でも呼び出せる一時スペース"
}
