{
  "name": "profile-copy",
  "title": "今ある構成を再利用する",
  "summary": "設定画面でプロファイルを複製し、含めるワークスペースを確認します。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "prepareSettings"
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "text:Laptop"
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "構成を再利用"
    },
    {
      "kind": "caption",
      "text": "プロファイルを右クリックして、複製を選びます。"
    },
    {
      "kind": "beat",
      "ms": 1400
    },
    {
      "kind": "rightClick",
      "app": "Tatami",
      "identifier": "text:Laptop"
    },
    {
      "kind": "beat",
      "ms": 1100
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "title:複製"
    },
    {
      "kind": "caption",
      "text": "複製するワークスペースと設定を選べます。"
    },
    {
      "kind": "beat",
      "ms": 2600
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "button:複製"
    },
    {
      "kind": "expectProfileCount",
      "count": 3
    },
    {
      "kind": "caption",
      "text": "新しいプロファイルは、元の構成とは別に編集できます。"
    },
    {
      "kind": "beat",
      "ms": 2300
    }
  ]
}
