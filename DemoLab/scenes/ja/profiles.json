{
  "name": "profiles",
  "title": "作業環境ごと切り替える",
  "summary": "プロファイルを切り替えると、ワークスペースの構成全体が変わります。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Editor"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "プロファイル"
    },
    {
      "kind": "caption",
      "text": "プロファイルを切り替えると、ワークスペースの構成全体が変わります。"
    },
    {
      "kind": "saveLayout",
      "text": "home"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift + cmd - 2"
    },
    {
      "kind": "waitProfile",
      "profile": "Desk"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas"
      ]
    },
    {
      "kind": "beat",
      "ms": 1700
    },
    {
      "kind": "caption",
      "text": "プロファイルごとに保存したウインドウ配置へ戻れます。"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift + cmd - 1"
    },
    {
      "kind": "waitProfile",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "assertLayout",
      "text": "home"
    },
    {
      "kind": "beat",
      "ms": 1900
    }
  ],
  "openingApps": [
    "Editor",
    "Docs"
  ]
}
