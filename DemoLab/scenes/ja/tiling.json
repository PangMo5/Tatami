{
  "name": "tiling",
  "title": "新しいウインドウが自然に収まる",
  "summary": "新しいウインドウは、選択中のウインドウの領域を分割して配置されます。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - left"
    },
    {
      "kind": "beat",
      "ms": 700
    },
    {
      "kind": "expectPlacement",
      "app": "Docs",
      "target": "Canvas",
      "value": "right"
    },
    {
      "kind": "activateApp",
      "app": "Docs"
    },
    {
      "kind": "beat",
      "ms": 700
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "自動タイル表示"
    },
    {
      "kind": "caption",
      "text": "新しいウインドウは、選択中のウインドウの領域を分割して配置されます。"
    },
    {
      "kind": "beat",
      "ms": 1300
    },
    {
      "kind": "activateApp",
      "app": "Docs"
    },
    {
      "kind": "expectFront",
      "app": "Docs"
    },
    {
      "kind": "beat",
      "ms": 600
    },
    {
      "kind": "key",
      "chord": "cmd - n"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs",
        "Docs"
      ]
    },
    {
      "kind": "expectPlacement",
      "app": "Docs",
      "target": "Canvas",
      "value": "right"
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "caption",
      "text": "新しいウインドウが入っても、ほかの領域の配置は変わりません。"
    },
    {
      "kind": "click",
      "app": "Canvas",
      "identifier": "canvas.forest"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "activateApp",
      "app": "Docs"
    },
    {
      "kind": "key",
      "chord": "cmd - w"
    },
    {
      "kind": "caption",
      "text": "ウインドウを閉じると、残ったウインドウが空いた領域を埋めます。"
    },
    {
      "kind": "beat",
      "ms": 2100
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ]
}
