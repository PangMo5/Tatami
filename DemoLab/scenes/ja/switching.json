{
  "name": "switching",
  "title": "必要なウインドウを選ぶ",
  "summary": "切り替えキーを長く押してウインドウを確認し、短く押して戻れます。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "appWindows",
      "app": "Docs",
      "count": 2
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "beat",
      "ms": 600
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "ウインドウ切り替え"
    },
    {
      "kind": "caption",
      "text": "ショートカットを押し続けて、今のワークスペースのウインドウを選びます。"
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "hold",
      "modifiers": "alt",
      "keys": [
        "tab"
      ],
      "gapMs": 900,
      "releaseAfterMs": 1600
    },
    {
      "kind": "beat",
      "ms": 800
    },
    {
      "kind": "caption",
      "text": "短く押すと、直前に使っていたウインドウへ戻ります。"
    },
    {
      "kind": "key",
      "chord": "alt - tab"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "key",
      "chord": "alt - tab"
    },
    {
      "kind": "beat",
      "ms": 1500
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs",
    "Docs"
  ]
}
