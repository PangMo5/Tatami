{
  "name" : "settings-search",
  "requires" : {
    "displays" : 1
  },
  "setup" : [
    {
      "kind" : "prepareSettings"
    },
    {
      "app" : "Tatami",
      "identifier" : "gearshape",
      "kind" : "click"
    }
  ],
  "steps" : [
    {
      "kind" : "chapter",
      "text" : "設定の検索"
    },
    {
      "kind" : "caption",
      "text" : "名前、ショートカット、MFF などの略語で設定を探せます。"
    },
    {
      "chord" : "cmd - f",
      "kind" : "key"
    },
    {
      "app" : "Tatami",
      "kind" : "typeText",
      "ms" : 100,
      "text" : "MFF"
    },
    {
      "app" : "Tatami",
      "identifier" : "window:settings-result-focus.mouseFollowsFocus",
      "kind" : "click"
    },
    {
      "app" : "Tatami",
      "identifier" : "window:setting-focus.mouseFollowsFocus",
      "kind" : "expectControlVisible"
    },
    {
      "kind" : "beat",
      "ms" : 1800
    },
    {
      "kind" : "caption",
      "text" : "結果を選ぶと、ページの下にある設定もすぐ表示されます。"
    },
    {
      "chord" : "cmd - f",
      "kind" : "key"
    },
    {
      "chord" : "cmd - a",
      "kind" : "key"
    },
    {
      "app" : "Tatami",
      "kind" : "typeText",
      "ms" : 80,
      "text" : "前のワークスペース"
    },
    {
      "app" : "Tatami",
      "identifier" : "window:settings-result-shortcuts.moveToPreviousWorkspace",
      "kind" : "click"
    },
    {
      "app" : "Tatami",
      "identifier" : "window:setting-shortcuts.moveToPreviousWorkspace",
      "kind" : "expectControlVisible"
    },
    {
      "kind" : "beat",
      "ms" : 2000
    }
  ],
  "summary" : "設定を検索し、該当する項目へ直接移動します。",
  "title" : "必要な設定を探す"
}
