{
  "name" : "workspace-copy",
  "requires" : {
    "displays" : 1
  },
  "setup" : [
    {
      "kind" : "clearOverlay"
    },
    {
      "app" : "Canvas",
      "autoOpen" : false,
      "kind" : "configureAssignment",
      "profile" : "Desk",
      "workspace" : "Design"
    },
    {
      "app" : "Canvas",
      "autoOpen" : false,
      "kind" : "expectAssignment",
      "profile" : "Desk",
      "workspace" : "Design"
    },
    {
      "kind" : "prepareSettings"
    },
    {
      "app" : "Tatami",
      "identifier" : "text:Desk",
      "kind" : "click"
    },
    {
      "app" : "Tatami",
      "identifier" : "text:Design",
      "kind" : "click"
    }
  ],
  "steps" : [
    {
      "kind" : "chapter",
      "text" : "ワークスペース設定のコピー"
    },
    {
      "kind" : "caption",
      "text" : "設定のコピー元にするワークスペースを選びます。"
    },
    {
      "kind" : "beat",
      "ms" : 1400
    },
    {
      "app" : "Tatami",
      "identifier" : "title:別のワークスペースからコピー…",
      "kind" : "click"
    },
    {
      "app" : "Tatami",
      "identifier" : "title:Laptop",
      "kind" : "hover"
    },
    {
      "kind" : "beat",
      "ms" : 900
    },
    {
      "app" : "Tatami",
      "identifier" : "title:Design",
      "kind" : "click"
    },
    {
      "kind" : "caption",
      "text" : "今のワークスペースへコピーする変更を、適用前に確認できます。"
    },
    {
      "kind" : "beat",
      "ms" : 2300
    },
    {
      "app" : "Tatami",
      "identifier" : "button:コピー",
      "kind" : "click"
    },
    {
      "app" : "Tatami",
      "enabled" : true,
      "identifier" : "sheet:button:適用",
      "kind" : "expectEnabled"
    },
    {
      "kind" : "caption",
      "text" : "既存のワークスペース設定を上書きする前に確認します。"
    },
    {
      "kind" : "beat",
      "ms" : 1800
    },
    {
      "app" : "Tatami",
      "identifier" : "sheet:button:適用",
      "kind" : "click"
    },
    {
      "app" : "Canvas",
      "autoOpen" : true,
      "kind" : "expectAssignment",
      "profile" : "Desk",
      "workspace" : "Design"
    },
    {
      "app" : "Docs",
      "kind" : "expectAssignment",
      "profile" : "Desk",
      "workspace" : "Design"
    },
    {
      "kind" : "caption",
      "text" : "選んだアプリと設定が、今のワークスペースにコピーされました。"
    },
    {
      "app" : "Tatami",
      "identifier" : "heading:レイアウト",
      "kind" : "click"
    },
    {
      "kind" : "beat",
      "ms" : 2400
    },
    {
      "kind" : "caption",
      "text" : "設定が同じワークスペースは「違いはありません」と表示され、選択できません。"
    },
    {
      "app" : "Tatami",
      "identifier" : "title:別のワークスペースからコピー…",
      "kind" : "click"
    },
    {
      "app" : "Tatami",
      "identifier" : "title:Laptop",
      "kind" : "hover"
    },
    {
      "app" : "Tatami",
      "enabled" : false,
      "identifier" : "title:Design · 違いはありません",
      "kind" : "expectEnabled"
    },
    {
      "kind" : "beat",
      "ms" : 2200
    },
    {
      "chord" : "esc",
      "kind" : "key"
    }
  ],
  "summary" : "別のワークスペースのアプリと設定を確認し、選んだ変更を適用します。",
  "title" : "ワークスペース間で設定をコピー"
}
