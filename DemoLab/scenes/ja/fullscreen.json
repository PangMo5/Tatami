{
  "name": "fullscreen",
  "title": "ワークスペースを広げて集中する",
  "summary": "一つのウインドウをワークスペースいっぱいに広げ、元の配置に戻します。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "ワークスペースの拡大"
    },
    {
      "kind": "caption",
      "text": "元の配置を保ったまま、一つのウインドウを大きく表示できます。"
    },
    {
      "kind": "saveLayout",
      "text": "home"
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - return"
    },
    {
      "kind": "click",
      "app": "Canvas",
      "identifier": "canvas.sand"
    },
    {
      "kind": "beat",
      "ms": 1200
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - return"
    },
    {
      "kind": "assertLayout",
      "text": "home"
    },
    {
      "kind": "caption",
      "text": "同じショートカットをもう一度押すと、元の配置に戻ります。"
    },
    {
      "kind": "beat",
      "ms": 1600
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ]
}
