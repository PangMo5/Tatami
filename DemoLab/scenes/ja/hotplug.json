{
  "name": "hotplug",
  "title": "画面に合わせて環境を切り替える",
  "summary": "2 台目を接続すると Desk プロファイルに切り替わります。外すと Laptop の配置に戻ります。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "画面に合わせたプロファイル"
    },
    {
      "kind": "caption",
      "text": "2 台目を接続すると、2 画面用の条件でプロファイルが自動切り替えされます。"
    },
    {
      "kind": "beat",
      "ms": 1400
    },
    {
      "kind": "saveLayout",
      "text": "home"
    },
    {
      "kind": "virtualDisplay",
      "connected": true
    },
    {
      "kind": "waitProfile",
      "profile": "Desk",
      "timeoutMs": 12000
    },
    {
      "kind": "expectHook",
      "field": "profile",
      "value": "Desk"
    },
    {
      "kind": "beat",
      "ms": 2500
    },
    {
      "kind": "caption",
      "text": "接続を外すと、1 画面用のプロファイルに自動で戻ります。"
    },
    {
      "kind": "virtualDisplay",
      "connected": false
    },
    {
      "kind": "waitProfile",
      "profile": "Laptop",
      "timeoutMs": 12000
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "assertLayout",
      "text": "home"
    },
    {
      "kind": "beat",
      "ms": 2000
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ],
  "captureSecondary": true
}
