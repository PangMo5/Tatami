{
  "name" : "layout-memory",
  "openingApps" : [
    "Editor",
    "Docs"
  ],
  "requires" : {
    "displays" : 1
  },
  "setup" : [
    {
      "field" : "autoBalance",
      "kind" : "configure",
      "value" : "\"both\""
    },
    {
      "display" : 0,
      "kind" : "pointer",
      "x" : 0.5,
      "y" : 0.5
    },
    {
      "kind" : "activateWorkspace",
      "profile" : "Laptop",
      "workspace" : "Chat"
    },
    {
      "apps" : [
        "Chat"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "kind" : "activateWorkspace",
      "profile" : "Laptop",
      "workspace" : "Write"
    },
    {
      "apps" : [
        "Editor",
        "Docs"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    }
  ],
  "steps" : [
    {
      "kind" : "chapter",
      "text" : "配置を記憶"
    },
    {
      "kind" : "caption",
      "text" : "エディタを広く使えるように比率を調整します。"
    },
    {
      "app" : "Editor",
      "kind" : "activateApp"
    },
    {
      "chord" : "ctrl + alt - =",
      "kind" : "key",
      "repeats" : 3
    },
    {
      "kind" : "saveLayout",
      "text" : "adjusted"
    },
    {
      "app" : "Editor",
      "kind" : "saveWindow"
    },
    {
      "app" : "Docs",
      "kind" : "saveWindow"
    },
    {
      "kind" : "beat",
      "ms" : 1300
    },
    {
      "kind" : "caption",
      "text" : "別のワークスペースから戻っても比率はそのままです。"
    },
    {
      "chord" : "ctrl + alt + shift - 3",
      "kind" : "key"
    },
    {
      "apps" : [
        "Chat"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "kind" : "beat",
      "ms" : 900
    },
    {
      "chord" : "ctrl + alt + shift - 1",
      "kind" : "key"
    },
    {
      "apps" : [
        "Editor",
        "Docs"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "kind" : "assertLayout",
      "text" : "adjusted"
    },
    {
      "kind" : "beat",
      "ms" : 1600
    },
    {
      "kind" : "caption",
      "text" : "アプリを開き直しても同じ配置に戻ります。"
    },
    {
      "app" : "Editor",
      "kind" : "activateApp"
    },
    {
      "chord" : "cmd - q",
      "kind" : "key"
    },
    {
      "apps" : [
        "Docs"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "chord" : "ctrl + alt + shift - 3",
      "kind" : "key"
    },
    {
      "apps" : [
        "Chat"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "kind" : "beat",
      "ms" : 700
    },
    {
      "chord" : "ctrl + alt + shift - 1",
      "kind" : "key"
    },
    {
      "apps" : [
        "Editor",
        "Docs"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "app" : "Editor",
      "kind" : "assertWindow"
    },
    {
      "app" : "Docs",
      "kind" : "assertWindow"
    },
    {
      "kind" : "beat",
      "ms" : 1800
    }
  ],
  "summary" : "比率を調整し、ワークスペースを切り替えてアプリを開き直しても配置を保ちます。",
  "title" : "調整した配置に戻る"
}
