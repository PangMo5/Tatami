{
  "name": "layouts",
  "title": "キーボードで配置を整える",
  "summary": "ウインドウを入れ替え、分割の向きと大きさを変え、全体を整えます。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "appWindows",
      "app": "Docs",
      "count": 2
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Docs",
        "Canvas"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "beat",
      "ms": 700
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "配置の操作"
    },
    {
      "kind": "caption",
      "text": "選択中のウインドウと隣のウインドウを入れ替えます。"
    },
    {
      "kind": "beat",
      "ms": 1300
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "saveLayout",
      "text": "home"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - left"
    },
    {
      "kind": "expectLayoutChanged",
      "text": "home"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "caption",
      "text": "左右分割と上下分割を切り替えます。"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - s"
    },
    {
      "kind": "beat",
      "ms": 1500
    },
    {
      "kind": "caption",
      "text": "選択中のウインドウの領域を広げます。"
    },
    {
      "kind": "saveLayout",
      "text": "before-grow"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - =",
      "repeats": 3
    },
    {
      "kind": "expectLayoutChanged",
      "text": "before-grow"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "caption",
      "text": "自動均等配置がオフの場合、基本の BSP 配置に戻します。"
    },
    {
      "kind": "saveLayout",
      "text": "before-balance"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - e"
    },
    {
      "kind": "expectLayoutChanged",
      "text": "before-balance"
    },
    {
      "kind": "beat",
      "ms": 2000
    }
  ],
  "openingApps": [
    "Docs",
    "Docs",
    "Canvas"
  ]
}
