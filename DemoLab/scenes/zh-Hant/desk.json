{
  "name": "desk",
  "title": "兩部顯示器，一套工作流程",
  "summary": "把設計和參考資料放在不同顯示器上，用一個快速鍵切換工作空間鏈。",
  "requires": {
    "displays": 2
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Desk"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "beat",
      "ms": 1500
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "多部顯示器"
    },
    {
      "kind": "caption",
      "text": "將不同的工作空間固定至不同的顯示器。"
    },
    {
      "kind": "saveLayout",
      "text": "home"
    },
    {
      "kind": "click",
      "app": "Canvas",
      "identifier": "canvas.sand"
    },
    {
      "kind": "beat",
      "ms": 1200
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - right"
    },
    {
      "kind": "expectFront",
      "app": "Docs"
    },
    {
      "kind": "click",
      "app": "Docs",
      "identifier": "docs.search"
    },
    {
      "kind": "typeText",
      "app": "Docs",
      "text": "標題",
      "ms": 65
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - left"
    },
    {
      "kind": "expectFront",
      "app": "Canvas"
    },
    {
      "kind": "caption",
      "text": "用工作空間鏈一起切換兩部顯示器。"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 2"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Review"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Review",
        "Chat"
      ]
    },
    {
      "kind": "beat",
      "ms": 1900
    },
    {
      "kind": "caption",
      "text": "一個快速鍵，恢復先前搭配使用的工作空間。"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 5"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Design"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "assertLayout",
      "text": "home"
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ]
}
