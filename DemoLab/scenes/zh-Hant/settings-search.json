{
  "name" : "settings-search",
  "requires" : {
    "displays" : 1
  },
  "setup" : [
    {
      "kind" : "prepareSettings"
    },
    {
      "app" : "Tatami",
      "identifier" : "gearshape",
      "kind" : "click"
    }
  ],
  "steps" : [
    {
      "kind" : "chapter",
      "text" : "搜尋設定"
    },
    {
      "kind" : "caption",
      "text" : "依名稱、快速鍵或 MFF 等縮寫尋找設定。"
    },
    {
      "chord" : "cmd - f",
      "kind" : "key"
    },
    {
      "app" : "Tatami",
      "kind" : "typeText",
      "ms" : 100,
      "text" : "MFF"
    },
    {
      "app" : "Tatami",
      "identifier" : "window:settings-result-focus.mouseFollowsFocus",
      "kind" : "click"
    },
    {
      "app" : "Tatami",
      "identifier" : "window:setting-focus.mouseFollowsFocus",
      "kind" : "expectControlVisible"
    },
    {
      "kind" : "beat",
      "ms" : 1800
    },
    {
      "kind" : "caption",
      "text" : "選取結果，即可顯示頁面下方的對應設定。"
    },
    {
      "chord" : "cmd - f",
      "kind" : "key"
    },
    {
      "chord" : "cmd - a",
      "kind" : "key"
    },
    {
      "app" : "Tatami",
      "kind" : "typeText",
      "ms" : 80,
      "text" : "上一個工作空間"
    },
    {
      "app" : "Tatami",
      "identifier" : "window:settings-result-shortcuts.moveToPreviousWorkspace",
      "kind" : "click"
    },
    {
      "app" : "Tatami",
      "identifier" : "window:setting-shortcuts.moveToPreviousWorkspace",
      "kind" : "expectControlVisible"
    },
    {
      "kind" : "beat",
      "ms" : 2000
    }
  ],
  "summary" : "搜尋設定，直接前往對應選項。",
  "title" : "找到需要的設定"
}
