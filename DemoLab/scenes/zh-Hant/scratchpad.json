{
  "name" : "scratchpad",
  "openingApps" : [
    "Canvas",
    "Docs"
  ],
  "requires" : {
    "displays" : 2
  },
  "setup" : [
    {
      "display" : 0,
      "kind" : "pointer",
      "x" : 0.5,
      "y" : 0.5
    },
    {
      "kind" : "activateWorkspace",
      "profile" : "Desk",
      "workspace" : "Design"
    },
    {
      "apps" : [
        "Canvas",
        "Docs"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "kind" : "saveLayout",
      "text" : "hosts"
    }
  ],
  "steps" : [
    {
      "kind" : "chapter",
      "text" : "暫存區"
    },
    {
      "kind" : "caption",
      "text" : "暫存工作空間只會在借用時開啟。"
    },
    {
      "chord" : "ctrl + alt + cmd - n",
      "kind" : "key"
    },
    {
      "apps" : [
        "Canvas",
        "Docs",
        "Notes"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "app" : "Notes",
      "identifier" : "notes.newTask",
      "kind" : "click"
    },
    {
      "app" : "Notes",
      "kind" : "typeText",
      "ms" : 45,
      "text" : "比較三種配色方向。"
    },
    {
      "chord" : "return",
      "kind" : "key"
    },
    {
      "field" : "lastTask",
      "kind" : "expectStory",
      "value" : "比較三種配色方向。"
    },
    {
      "kind" : "caption",
      "text" : "將游標移到其他顯示器，再按同一快速鍵。"
    },
    {
      "app" : "Docs",
      "identifier" : "docs.search",
      "kind" : "hover",
      "ms" : 1400
    },
    {
      "kind" : "beat",
      "ms" : 700
    },
    {
      "chord" : "ctrl + alt + cmd - n",
      "kind" : "key"
    },
    {
      "app" : "Notes",
      "kind" : "expectPlacement",
      "target" : "Docs",
      "value" : "right"
    },
    {
      "app" : "Notes",
      "kind" : "expectPointerCentered"
    },
    {
      "kind" : "caption",
      "text" : "同一便箋移到這裡，原工作空間還原先前的配置。"
    },
    {
      "field" : "lastTask",
      "kind" : "expectStory",
      "value" : "比較三種配色方向。"
    },
    {
      "kind" : "beat",
      "ms" : 1800
    },
    {
      "app" : "Canvas",
      "identifier" : "canvas.sand",
      "kind" : "hover",
      "ms" : 1400
    },
    {
      "kind" : "beat",
      "ms" : 700
    },
    {
      "chord" : "ctrl + alt + cmd - n",
      "kind" : "key"
    },
    {
      "app" : "Notes",
      "kind" : "expectPlacement",
      "target" : "Docs",
      "value" : "left"
    },
    {
      "field" : "lastTask",
      "kind" : "expectStory",
      "value" : "比較三種配色方向。"
    },
    {
      "kind" : "beat",
      "ms" : 1800
    },
    {
      "chord" : "ctrl + alt + cmd - /",
      "kind" : "key"
    },
    {
      "apps" : [
        "Canvas",
        "Docs"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "kind" : "assertLayout",
      "text" : "hosts"
    },
    {
      "kind" : "beat",
      "ms" : 1000
    }
  ],
  "summary" : "使用同一快速鍵，將保留內容的便箋帶到其他顯示器。",
  "title" : "隨時叫出的暫存區"
}
