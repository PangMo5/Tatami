{
  "name": "layouts",
  "title": "用鍵盤調整排列",
  "summary": "交換視窗、變更分割方向、調整大小，再平均調整整個排列。",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "appWindows",
      "app": "Docs",
      "count": 2
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Docs",
        "Canvas"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "beat",
      "ms": 700
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "排列控制"
    },
    {
      "kind": "caption",
      "text": "交換目前選取視窗與相鄰視窗的位置。"
    },
    {
      "kind": "beat",
      "ms": 1300
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "saveLayout",
      "text": "home"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - left"
    },
    {
      "kind": "expectLayoutChanged",
      "text": "home"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "caption",
      "text": "在左右分割與上下分割之間切換。"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - s"
    },
    {
      "kind": "beat",
      "ms": 1500
    },
    {
      "kind": "caption",
      "text": "擴大目前選取視窗所占的區域。"
    },
    {
      "kind": "saveLayout",
      "text": "before-grow"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - =",
      "repeats": 3
    },
    {
      "kind": "expectLayoutChanged",
      "text": "before-grow"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "caption",
      "text": "關閉自動平衡時，平衡指令會恢復預設 BSP 排列。"
    },
    {
      "kind": "saveLayout",
      "text": "before-balance"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - e"
    },
    {
      "kind": "expectLayoutChanged",
      "text": "before-balance"
    },
    {
      "kind": "beat",
      "ms": 2000
    }
  ],
  "openingApps": [
    "Docs",
    "Docs",
    "Canvas"
  ]
}
