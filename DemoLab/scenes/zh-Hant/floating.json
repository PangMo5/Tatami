{
  "name" : "floating",
  "requires" : {
    "displays" : 1
  },
  "setup" : [
    {
      "kind" : "clearOverlay"
    },
    {
      "display" : 0,
      "kind" : "pointer",
      "x" : 0.5,
      "y" : 0.5
    },
    {
      "kind" : "activateWorkspace",
      "profile" : "Laptop",
      "workspace" : "Write"
    },
    {
      "apps" : [
        "Editor",
        "Docs"
      ],
      "kind" : "waitWindows"
    },
    {
      "kind" : "activateWorkspace",
      "profile" : "Laptop",
      "workspace" : "Focus"
    },
    {
      "apps" : [
        "Canvas",
        "Notes"
      ],
      "kind" : "waitWindows"
    },
    {
      "app" : "Canvas",
      "kind" : "activateApp"
    },
    {
      "args" : [
        "layout",
        "balance"
      ],
      "kind" : "cli"
    },
    {
      "kind" : "beat",
      "ms" : 1800
    }
  ],
  "steps" : [
    {
      "kind" : "chapter",
      "text" : "置頂"
    },
    {
      "kind" : "caption",
      "text" : "設為保持最上層的視窗，會持續顯示在工作空間上方。"
    },
    {
      "activate" : false,
      "app" : "Notes",
      "identifier" : "notes.newTask",
      "kind" : "click"
    },
    {
      "app" : "Notes",
      "kind" : "typeText",
      "ms" : 65,
      "text" : "檢查較小尺寸下的預覽。"
    },
    {
      "chord" : "return",
      "kind" : "key"
    },
    {
      "field" : "lastTask",
      "kind" : "expectStory",
      "value" : "檢查較小尺寸下的預覽。"
    },
    {
      "app" : "Notes",
      "kind" : "saveWindow"
    },
    {
      "kind" : "beat",
      "ms" : 1200
    },
    {
      "kind" : "caption",
      "text" : "切換為並排，讓視窗加入自動排列。"
    },
    {
      "app" : "Notes",
      "kind" : "activateApp"
    },
    {
      "chord" : "alt + cmd - return",
      "kind" : "key"
    },
    {
      "app" : "Tatami",
      "enabled" : true,
      "identifier" : "confirm-assignment",
      "kind" : "expectEnabled"
    },
    {
      "kind" : "beat",
      "ms" : 1400
    },
    {
      "activate" : false,
      "app" : "Tatami",
      "identifier" : "confirm-assignment",
      "kind" : "click"
    },
    {
      "app" : "Notes",
      "kind" : "expectAssignment",
      "layout" : "tiled",
      "profile" : "Laptop",
      "workspace" : "Focus"
    },
    {
      "kind" : "beat",
      "ms" : 1600
    },
    {
      "kind" : "caption",
      "text" : "需要時，可以再次切換為保持最上層。"
    },
    {
      "chord" : "alt + cmd - return",
      "kind" : "key"
    },
    {
      "app" : "Tatami",
      "enabled" : true,
      "identifier" : "confirm-assignment",
      "kind" : "expectEnabled"
    },
    {
      "kind" : "beat",
      "ms" : 1400
    },
    {
      "activate" : false,
      "app" : "Tatami",
      "identifier" : "confirm-assignment",
      "kind" : "click"
    },
    {
      "app" : "Notes",
      "kind" : "expectAssignment",
      "layout" : "floating",
      "profile" : "Laptop",
      "workspace" : "Focus"
    },
    {
      "kind" : "beat",
      "ms" : 400
    },
    {
      "app" : "Notes",
      "kind" : "restoreWindow"
    },
    {
      "app" : "Notes",
      "kind" : "assertWindow"
    },
    {
      "kind" : "beat",
      "ms" : 1100
    },
    {
      "app" : "Canvas",
      "kind" : "activateApp"
    },
    {
      "kind" : "beat",
      "ms" : 1100
    },
    {
      "app" : "Notes",
      "kind" : "assertWindow"
    }
  ],
  "summary" : "在置頂和參與並排之間切換便箋，並使用其實際控制項。",
  "title" : "把便箋放在工作空間上方"
}
