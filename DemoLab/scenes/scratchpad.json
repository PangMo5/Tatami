{
  "name": "scratchpad",
  "title": "Keep a reusable scratchpad",
  "summary": "Keep a note’s contents and bring it to another display with the same shortcut.",
  "requires": {
    "displays": 2
  },
  "setup": [
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Desk"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ],
      "exact": true
    },
    {
      "kind": "saveLayout",
      "text": "hosts"
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "SCRATCHPADS"
    },
    {
      "kind": "caption",
      "text": "A scratchpad opens only when you borrow it."
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - n"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs",
        "Notes"
      ],
      "exact": true
    },
    {
      "kind": "click",
      "app": "Notes",
      "identifier": "notes.newTask"
    },
    {
      "kind": "typeText",
      "app": "Notes",
      "text": "Compare the three color directions.",
      "ms": 45
    },
    {
      "kind": "key",
      "chord": "return"
    },
    {
      "kind": "expectStory",
      "field": "lastTask",
      "value": "Compare the three color directions."
    },
    {
      "kind": "caption",
      "text": "Move the pointer to another display, then use the same shortcut."
    },
    {
      "kind": "hover",
      "app": "Docs",
      "identifier": "docs.search",
      "ms": 1400
    },
    {
      "kind": "beat",
      "ms": 700
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - n"
    },
    {
      "kind": "expectPlacement",
      "app": "Notes",
      "target": "Docs",
      "value": "right"
    },
    {
      "kind": "expectPointerCentered",
      "app": "Notes"
    },
    {
      "kind": "caption",
      "text": "The same note moves here. Its previous workspace regains the space."
    },
    {
      "kind": "expectStory",
      "field": "lastTask",
      "value": "Compare the three color directions."
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "hover",
      "app": "Canvas",
      "identifier": "canvas.sand",
      "ms": 1400
    },
    {
      "kind": "beat",
      "ms": 700
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - n"
    },
    {
      "kind": "expectPlacement",
      "app": "Notes",
      "target": "Docs",
      "value": "left"
    },
    {
      "kind": "expectStory",
      "field": "lastTask",
      "value": "Compare the three color directions."
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - /"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ],
      "exact": true
    },
    {
      "kind": "assertLayout",
      "text": "hosts"
    },
    {
      "kind": "beat",
      "ms": 1000
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ]
}
