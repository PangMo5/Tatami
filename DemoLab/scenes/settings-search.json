{
  "name": "settings-search",
  "title": "Find the setting you need",
  "summary": "Search Settings, then jump straight to the matching control.",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "prepareSettings"
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "gearshape"
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "SETTINGS SEARCH"
    },
    {
      "kind": "caption",
      "text": "Search by name, shortcut, or an abbreviation such as MFF."
    },
    {
      "kind": "key",
      "chord": "cmd - f"
    },
    {
      "kind": "typeText",
      "app": "Tatami",
      "text": "MFF",
      "ms": 100
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "window:settings-result-focus.mouseFollowsFocus"
    },
    {
      "kind": "expectControlVisible",
      "app": "Tatami",
      "identifier": "window:setting-focus.mouseFollowsFocus"
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "caption",
      "text": "Select a result to reveal its setting, even farther down the page."
    },
    {
      "kind": "key",
      "chord": "cmd - f"
    },
    {
      "kind": "key",
      "chord": "cmd - a"
    },
    {
      "kind": "typeText",
      "app": "Tatami",
      "text": "previous workspace",
      "ms": 80
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "window:settings-result-shortcuts.moveToPreviousWorkspace"
    },
    {
      "kind": "expectControlVisible",
      "app": "Tatami",
      "identifier": "window:setting-shortcuts.moveToPreviousWorkspace"
    },
    {
      "kind": "beat",
      "ms": 2000
    }
  ]
}
