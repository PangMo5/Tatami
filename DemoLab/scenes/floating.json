{
  "name": "floating",
  "title": "Keep a note above this workspace",
  "summary": "Switch a note between Always on Top and tiled placement, and interact with its real controls.",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Focus",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Notes"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "ALWAYS ON TOP"
    },
    {
      "kind": "caption",
      "text": "Always on Top keeps this window above the workspace."
    },
    {
      "kind": "click",
      "app": "Notes",
      "identifier": "notes.newTask",
      "activate": false
    },
    {
      "kind": "typeText",
      "app": "Notes",
      "text": "Check the preview at a smaller size.",
      "ms": 65
    },
    {
      "kind": "key",
      "chord": "return"
    },
    {
      "kind": "expectStory",
      "field": "lastTask",
      "value": "Check the preview at a smaller size."
    },
    {
      "kind": "saveWindow",
      "app": "Notes"
    },
    {
      "kind": "beat",
      "ms": 1200
    },
    {
      "kind": "caption",
      "text": "Switch to tiled placement to include the window in the layout."
    },
    {
      "kind": "activateApp",
      "app": "Notes"
    },
    {
      "kind": "key",
      "chord": "alt + cmd - return"
    },
    {
      "kind": "expectEnabled",
      "app": "Tatami",
      "identifier": "confirm-assignment",
      "enabled": true
    },
    {
      "kind": "beat",
      "ms": 1400
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "confirm-assignment",
      "activate": false
    },
    {
      "kind": "expectAssignment",
      "app": "Notes",
      "workspace": "Focus",
      "profile": "Laptop",
      "layout": "tiled"
    },
    {
      "kind": "beat",
      "ms": 1600
    },
    {
      "kind": "caption",
      "text": "Switch back to Always on Top whenever you need it."
    },
    {
      "kind": "key",
      "chord": "alt + cmd - return"
    },
    {
      "kind": "expectEnabled",
      "app": "Tatami",
      "identifier": "confirm-assignment",
      "enabled": true
    },
    {
      "kind": "beat",
      "ms": 1400
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "confirm-assignment",
      "activate": false
    },
    {
      "kind": "expectAssignment",
      "app": "Notes",
      "workspace": "Focus",
      "profile": "Laptop",
      "layout": "floating"
    },
    {
      "kind": "beat",
      "ms": 400
    },
    {
      "kind": "restoreWindow",
      "app": "Notes"
    },
    {
      "kind": "assertWindow",
      "app": "Notes"
    },
    {
      "kind": "beat",
      "ms": 1100
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "beat",
      "ms": 1100
    },
    {
      "kind": "assertWindow",
      "app": "Notes"
    }
  ]
}
