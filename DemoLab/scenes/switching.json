{
  "name": "switching",
  "title": "Choose the window you need",
  "summary": "Hold the switcher shortcut to inspect the windows in this workspace, then switch back with a quick tap.",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "appWindows",
      "app": "Docs",
      "count": 2
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "beat",
      "ms": 600
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "WINDOW SWITCHER"
    },
    {
      "kind": "caption",
      "text": "Hold the shortcut to choose a window in the current workspace."
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "hold",
      "modifiers": "alt",
      "keys": [
        "tab"
      ],
      "gapMs": 900,
      "releaseAfterMs": 1600
    },
    {
      "kind": "beat",
      "ms": 800
    },
    {
      "kind": "caption",
      "text": "Tap the shortcut to return to the last-used window."
    },
    {
      "kind": "key",
      "chord": "alt - tab"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "key",
      "chord": "alt - tab"
    },
    {
      "kind": "beat",
      "ms": 1500
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs",
    "Docs"
  ]
}
