{
  "name": "cli",
  "title": "CLI로 집중할 환경 준비하기",
  "summary": "실제 작업 공간 목록을 확인한 뒤 활성화·균등 배치·빌려오기를 묶은 스크립트를 실행해요.",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Build",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Terminal"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Terminal"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "커맨드라인"
    },
    {
      "kind": "caption",
      "text": "CLI로 작업 공간 목록을 확인하고 실행 중인 Tatami를 조작해요."
    },
    {
      "kind": "click",
      "app": "Terminal",
      "identifier": "terminal.command"
    },
    {
      "kind": "typeText",
      "app": "Terminal",
      "text": "tatami workspace list",
      "ms": 65
    },
    {
      "kind": "key",
      "chord": "return"
    },
    {
      "kind": "expectCommand",
      "text": "tatami workspace list",
      "code": 0
    },
    {
      "kind": "beat",
      "ms": 1600
    },
    {
      "kind": "caption",
      "text": "스크립트 하나로 작업 공간 전환·배치·빌려오기를 실행해요."
    },
    {
      "kind": "click",
      "app": "Terminal",
      "identifier": "terminal.command"
    },
    {
      "kind": "typeText",
      "app": "Terminal",
      "text": "focus-session",
      "ms": 65
    },
    {
      "kind": "key",
      "chord": "return"
    },
    {
      "kind": "expectCommand",
      "text": "focus-session",
      "code": 0
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs",
        "Notes"
      ]
    },
    {
      "kind": "expectHook",
      "field": "workspace",
      "value": "Design"
    },
    {
      "kind": "beat",
      "ms": 2000
    }
  ],
  "openingApps": [
    "Terminal"
  ]
}
