{
  "name" : "layout-memory",
  "openingApps" : [
    "Editor",
    "Docs"
  ],
  "requires" : {
    "displays" : 1
  },
  "setup" : [
    {
      "field" : "autoBalance",
      "kind" : "configure",
      "value" : "\"both\""
    },
    {
      "display" : 0,
      "kind" : "pointer",
      "x" : 0.5,
      "y" : 0.5
    },
    {
      "kind" : "activateWorkspace",
      "profile" : "Laptop",
      "workspace" : "Chat"
    },
    {
      "apps" : [
        "Chat"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "kind" : "activateWorkspace",
      "profile" : "Laptop",
      "workspace" : "Write"
    },
    {
      "apps" : [
        "Editor",
        "Docs"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    }
  ],
  "steps" : [
    {
      "kind" : "chapter",
      "text" : "배치 기억"
    },
    {
      "kind" : "caption",
      "text" : "편집기에 공간을 더 주도록 비율을 바꿔요."
    },
    {
      "app" : "Editor",
      "kind" : "activateApp"
    },
    {
      "chord" : "ctrl + alt - =",
      "kind" : "key",
      "repeats" : 3
    },
    {
      "kind" : "saveLayout",
      "text" : "adjusted"
    },
    {
      "app" : "Editor",
      "kind" : "saveWindow"
    },
    {
      "app" : "Docs",
      "kind" : "saveWindow"
    },
    {
      "kind" : "beat",
      "ms" : 1300
    },
    {
      "kind" : "caption",
      "text" : "다른 작업 공간에 다녀와도 비율은 그대로예요."
    },
    {
      "chord" : "ctrl + alt + shift - 3",
      "kind" : "key"
    },
    {
      "apps" : [
        "Chat"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "kind" : "beat",
      "ms" : 900
    },
    {
      "chord" : "ctrl + alt + shift - 1",
      "kind" : "key"
    },
    {
      "apps" : [
        "Editor",
        "Docs"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "kind" : "assertLayout",
      "text" : "adjusted"
    },
    {
      "kind" : "beat",
      "ms" : 1600
    },
    {
      "kind" : "caption",
      "text" : "앱을 다시 열어도 같은 배치로 돌아와요."
    },
    {
      "app" : "Editor",
      "kind" : "activateApp"
    },
    {
      "chord" : "cmd - q",
      "kind" : "key"
    },
    {
      "apps" : [
        "Docs"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "chord" : "ctrl + alt + shift - 3",
      "kind" : "key"
    },
    {
      "apps" : [
        "Chat"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "kind" : "beat",
      "ms" : 700
    },
    {
      "chord" : "ctrl + alt + shift - 1",
      "kind" : "key"
    },
    {
      "apps" : [
        "Editor",
        "Docs"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "app" : "Editor",
      "kind" : "assertWindow"
    },
    {
      "app" : "Docs",
      "kind" : "assertWindow"
    },
    {
      "kind" : "beat",
      "ms" : 1800
    }
  ],
  "summary" : "비율을 바꾼 뒤 작업 공간을 오가고 앱을 다시 열어도 배치를 유지해요.",
  "title" : "조절한 배치로 돌아와요"
}
