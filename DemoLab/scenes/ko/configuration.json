{
  "name": "configuration",
  "title": "TOML을 수정하고 바로 확인하기",
  "summary": "실행 중에 TOML 파일을 수정해 창 사이 간격을 바꿔요.",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Build",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Terminal"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Terminal"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "TOML / 바로 적용"
    },
    {
      "kind": "caption",
      "text": "실행 중에 TOML 파일을 수정해 창 사이 간격을 바꿔요."
    },
    {
      "kind": "click",
      "app": "Terminal",
      "identifier": "terminal.command"
    },
    {
      "kind": "typeText",
      "app": "Terminal",
      "text": "set-spacing 32",
      "ms": 65
    },
    {
      "kind": "key",
      "chord": "return"
    },
    {
      "kind": "expectCommand",
      "text": "set-spacing 32",
      "code": 0
    },
    {
      "kind": "beat",
      "ms": 1500
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 5"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Design"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "beat",
      "ms": 1600
    },
    {
      "kind": "caption",
      "text": "지원하는 설정은 재시작하지 않아도 자동으로 반영돼요."
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 4"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Build"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Terminal"
      ]
    },
    {
      "kind": "click",
      "app": "Terminal",
      "identifier": "terminal.command"
    },
    {
      "kind": "typeText",
      "app": "Terminal",
      "text": "set-spacing 10",
      "ms": 65
    },
    {
      "kind": "key",
      "chord": "return"
    },
    {
      "kind": "expectCommand",
      "text": "set-spacing 10",
      "code": 0
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 5"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Design"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "beat",
      "ms": 1600
    }
  ],
  "openingApps": [
    "Terminal"
  ]
}
