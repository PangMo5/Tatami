{
  "name": "pause",
  "title": "직접 창 배치하기",
  "summary": "자동 타일링을 잠시 멈추고 창을 자유롭게 놓아요. 다시 켜면 정돈된 배치로 돌아와요.",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "일시 정지와 다시 시작"
    },
    {
      "kind": "caption",
      "text": "자유롭게 놓고 싶을 때 타일링을 잠시 멈춰요."
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift + cmd - z"
    },
    {
      "kind": "saveLayout",
      "text": "home"
    },
    {
      "kind": "dragWindow",
      "app": "Docs",
      "target": "Canvas",
      "x": 0.65,
      "y": 0.35
    },
    {
      "kind": "expectLayoutChanged",
      "text": "home"
    },
    {
      "kind": "beat",
      "ms": 1500
    },
    {
      "kind": "caption",
      "text": "다시 켜면 Tatami가 창을 정리해요."
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift + cmd - z"
    },
    {
      "kind": "beat",
      "ms": 1900
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - e"
    },
    {
      "kind": "beat",
      "ms": 1200
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ]
}
