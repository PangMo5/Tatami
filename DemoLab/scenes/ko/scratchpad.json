{
  "name" : "scratchpad",
  "openingApps" : [
    "Canvas",
    "Docs"
  ],
  "requires" : {
    "displays" : 2
  },
  "setup" : [
    {
      "display" : 0,
      "kind" : "pointer",
      "x" : 0.5,
      "y" : 0.5
    },
    {
      "kind" : "activateWorkspace",
      "profile" : "Desk",
      "workspace" : "Design"
    },
    {
      "apps" : [
        "Canvas",
        "Docs"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "kind" : "saveLayout",
      "text" : "hosts"
    }
  ],
  "steps" : [
    {
      "kind" : "chapter",
      "text" : "임시 공간"
    },
    {
      "kind" : "caption",
      "text" : "임시 작업 공간은 빌려올 때만 열려요."
    },
    {
      "chord" : "ctrl + alt + cmd - n",
      "kind" : "key"
    },
    {
      "apps" : [
        "Canvas",
        "Docs",
        "Notes"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "app" : "Notes",
      "identifier" : "notes.newTask",
      "kind" : "click"
    },
    {
      "app" : "Notes",
      "kind" : "typeText",
      "ms" : 45,
      "text" : "세 가지 색상 방향을 비교해요."
    },
    {
      "chord" : "return",
      "kind" : "key"
    },
    {
      "field" : "lastTask",
      "kind" : "expectStory",
      "value" : "세 가지 색상 방향을 비교해요."
    },
    {
      "kind" : "caption",
      "text" : "마우스를 다른 화면으로 옮긴 뒤 같은 단축키를 눌러요."
    },
    {
      "app" : "Docs",
      "identifier" : "docs.search",
      "kind" : "hover",
      "ms" : 1400
    },
    {
      "kind" : "beat",
      "ms" : 700
    },
    {
      "chord" : "ctrl + alt + cmd - n",
      "kind" : "key"
    },
    {
      "app" : "Notes",
      "kind" : "expectPlacement",
      "target" : "Docs",
      "value" : "right"
    },
    {
      "app" : "Notes",
      "kind" : "expectPointerCentered"
    },
    {
      "kind" : "caption",
      "text" : "같은 메모가 이쪽으로 옮겨오고 이전 작업 공간은 원래 배치로 돌아가요."
    },
    {
      "field" : "lastTask",
      "kind" : "expectStory",
      "value" : "세 가지 색상 방향을 비교해요."
    },
    {
      "kind" : "beat",
      "ms" : 1800
    },
    {
      "app" : "Canvas",
      "identifier" : "canvas.sand",
      "kind" : "hover",
      "ms" : 1400
    },
    {
      "kind" : "beat",
      "ms" : 700
    },
    {
      "chord" : "ctrl + alt + cmd - n",
      "kind" : "key"
    },
    {
      "app" : "Notes",
      "kind" : "expectPlacement",
      "target" : "Docs",
      "value" : "left"
    },
    {
      "field" : "lastTask",
      "kind" : "expectStory",
      "value" : "세 가지 색상 방향을 비교해요."
    },
    {
      "kind" : "beat",
      "ms" : 1800
    },
    {
      "chord" : "ctrl + alt + cmd - /",
      "kind" : "key"
    },
    {
      "apps" : [
        "Canvas",
        "Docs"
      ],
      "exact" : true,
      "kind" : "waitWindows"
    },
    {
      "kind" : "assertLayout",
      "text" : "hosts"
    },
    {
      "kind" : "beat",
      "ms" : 1000
    }
  ],
  "summary" : "같은 단축키로 메모 내용을 유지한 채 다른 화면으로 가져와요.",
  "title" : "다시 꺼내 쓰는 임시 공간"
}
