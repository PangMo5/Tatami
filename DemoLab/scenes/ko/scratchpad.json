{
  "name": "scratchpad",
  "title": "다시 꺼내 쓰는 임시 공간",
  "summary": "다시 빌려와도 앱에서 작업한 내용은 그대로 남아 있어요.",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "임시 공간"
    },
    {
      "kind": "caption",
      "text": "임시 작업 공간은 빌려올 때만 열려요."
    },
    {
      "kind": "saveLayout",
      "text": "home"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - n"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Notes"
      ]
    },
    {
      "kind": "click",
      "app": "Notes",
      "identifier": "notes.newTask"
    },
    {
      "kind": "typeText",
      "app": "Notes",
      "text": "세 가지 색상 방향을 비교해요.",
      "ms": 65
    },
    {
      "kind": "key",
      "chord": "return"
    },
    {
      "kind": "expectStory",
      "field": "lastTask",
      "value": "세 가지 색상 방향을 비교해요."
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - /"
    },
    {
      "kind": "assertLayout",
      "text": "home"
    },
    {
      "kind": "caption",
      "text": "다시 빌려와도 앱에서 작업한 내용은 그대로 남아 있어요."
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - n"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Notes"
      ]
    },
    {
      "kind": "expectStory",
      "field": "lastTask",
      "value": "세 가지 색상 방향을 비교해요."
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + cmd - /"
    },
    {
      "kind": "assertLayout",
      "text": "home"
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ]
}
