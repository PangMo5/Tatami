{
  "name": "tiling",
  "title": "새 창이 제자리를 찾도록 하기",
  "summary": "새 창을 열면 선택한 창의 영역을 나눠 함께 배치해요.",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "key",
      "chord": "ctrl + alt - left"
    },
    {
      "kind": "beat",
      "ms": 700
    },
    {
      "kind": "expectPlacement",
      "app": "Docs",
      "target": "Canvas",
      "value": "right"
    },
    {
      "kind": "activateApp",
      "app": "Docs"
    },
    {
      "kind": "beat",
      "ms": 700
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "자동 타일링"
    },
    {
      "kind": "caption",
      "text": "새 창을 열면 선택한 창의 영역을 나눠 함께 배치해요."
    },
    {
      "kind": "beat",
      "ms": 1300
    },
    {
      "kind": "activateApp",
      "app": "Docs"
    },
    {
      "kind": "expectFront",
      "app": "Docs"
    },
    {
      "kind": "beat",
      "ms": 600
    },
    {
      "kind": "key",
      "chord": "cmd - n"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs",
        "Docs"
      ]
    },
    {
      "kind": "expectPlacement",
      "app": "Docs",
      "target": "Canvas",
      "value": "right"
    },
    {
      "kind": "beat",
      "ms": 1800
    },
    {
      "kind": "caption",
      "text": "새 창이 들어와도 다른 영역의 창은 제자리를 유지해요."
    },
    {
      "kind": "click",
      "app": "Canvas",
      "identifier": "canvas.forest"
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "activateApp",
      "app": "Docs"
    },
    {
      "kind": "key",
      "chord": "cmd - w"
    },
    {
      "kind": "caption",
      "text": "창을 닫으면 남은 창이 빈 공간을 채워요."
    },
    {
      "kind": "beat",
      "ms": 2100
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ]
}
