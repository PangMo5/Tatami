{
  "name": "membership",
  "title": "작업에 맞춰 앱 옮기기",
  "summary": "단축키로 현재 앱을 다른 작업 공간에 옮겨요.",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Editor"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "앱 배정"
    },
    {
      "kind": "caption",
      "text": "단축키로 현재 앱을 다른 작업 공간에 옮겨요."
    },
    {
      "kind": "activateApp",
      "app": "Docs"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - ]"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Review"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Review",
        "Docs"
      ]
    },
    {
      "kind": "beat",
      "ms": 1400
    },
    {
      "kind": "caption",
      "text": "옮긴 앱은 원래 작업 공간에서 빠져요."
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 1"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Write"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor"
      ]
    },
    {
      "kind": "beat",
      "ms": 1600
    },
    {
      "kind": "caption",
      "text": "같은 방식의 단축키로 앱을 다시 옮길 수 있어요."
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 2"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Review"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Review",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Docs"
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - ["
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Write"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "beat",
      "ms": 1600
    }
  ],
  "openingApps": [
    "Editor",
    "Docs"
  ]
}
