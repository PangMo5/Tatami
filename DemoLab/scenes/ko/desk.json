{
  "name": "desk",
  "title": "두 화면으로 이어지는 작업",
  "summary": "디자인과 참고 자료를 다른 화면에 두고, 단축키 하나로 작업 공간 체인을 전환해요.",
  "requires": {
    "displays": 2
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Desk"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "beat",
      "ms": 1500
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "여러 화면"
    },
    {
      "kind": "caption",
      "text": "화면마다 다른 작업 공간을 고정해 사용할 수 있어요."
    },
    {
      "kind": "saveLayout",
      "text": "home"
    },
    {
      "kind": "click",
      "app": "Canvas",
      "identifier": "canvas.sand"
    },
    {
      "kind": "beat",
      "ms": 1200
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - right"
    },
    {
      "kind": "expectFront",
      "app": "Docs"
    },
    {
      "kind": "click",
      "app": "Docs",
      "identifier": "docs.search"
    },
    {
      "kind": "typeText",
      "app": "Docs",
      "text": "제목",
      "ms": 65
    },
    {
      "kind": "beat",
      "ms": 1000
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - left"
    },
    {
      "kind": "expectFront",
      "app": "Canvas"
    },
    {
      "kind": "caption",
      "text": "작업 공간 체인으로 두 화면을 함께 바꿔요."
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 2"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Review"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Review",
        "Chat"
      ]
    },
    {
      "kind": "beat",
      "ms": 1900
    },
    {
      "kind": "caption",
      "text": "단축키 하나로 이전에 함께 쓰던 작업 공간들로 돌아와요."
    },
    {
      "kind": "key",
      "chord": "ctrl + alt + shift - 5"
    },
    {
      "kind": "waitWorkspace",
      "workspace": "Design"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "assertLayout",
      "text": "home"
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ]
}
