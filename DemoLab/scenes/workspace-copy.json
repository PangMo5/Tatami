{
  "name": "workspace-copy",
  "title": "Copy settings between workspaces",
  "summary": "Use Copy from to review another workspace’s apps and settings, then apply the selected changes.",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "prepareSettings"
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "text:Desk"
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "text:Design"
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "COPY WORKSPACE SETTINGS"
    },
    {
      "kind": "caption",
      "text": "Choose the workspace whose settings you want to copy."
    },
    {
      "kind": "beat",
      "ms": 1400
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "title:Copy from another workspace…"
    },
    {
      "kind": "hover",
      "app": "Tatami",
      "identifier": "title:Laptop"
    },
    {
      "kind": "beat",
      "ms": 900
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "title:Design"
    },
    {
      "kind": "caption",
      "text": "Review the changes before copying them into this workspace."
    },
    {
      "kind": "beat",
      "ms": 2300
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "button:Copy"
    },
    {
      "kind": "expectAssignment",
      "app": "Docs",
      "workspace": "Design",
      "profile": "Desk"
    },
    {
      "kind": "caption",
      "text": "The selected apps and settings are now copied."
    },
    {
      "kind": "click",
      "app": "Tatami",
      "identifier": "heading:Layout"
    },
    {
      "kind": "beat",
      "ms": 2400
    }
  ]
}
