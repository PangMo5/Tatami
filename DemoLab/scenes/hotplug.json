{
  "name": "hotplug",
  "title": "Your setup follows the displays",
  "summary": "Connect a second display to activate the Desk profile. Disconnect it to return to the Laptop arrangement.",
  "requires": {
    "displays": 1
  },
  "setup": [
    {
      "kind": "clearOverlay"
    },
    {
      "kind": "pointer",
      "display": 0,
      "x": 0.5,
      "y": 0.5
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Write",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Editor",
        "Docs"
      ]
    },
    {
      "kind": "activateWorkspace",
      "workspace": "Design",
      "profile": "Laptop"
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "activateApp",
      "app": "Canvas"
    },
    {
      "kind": "cli",
      "args": [
        "layout",
        "balance"
      ]
    },
    {
      "kind": "beat",
      "ms": 1800
    }
  ],
  "steps": [
    {
      "kind": "chapter",
      "text": "DISPLAY-AWARE PROFILES"
    },
    {
      "kind": "caption",
      "text": "Connect a second display to trigger the two-display profile rule."
    },
    {
      "kind": "beat",
      "ms": 1400
    },
    {
      "kind": "saveLayout",
      "text": "home"
    },
    {
      "kind": "virtualDisplay",
      "connected": true
    },
    {
      "kind": "waitProfile",
      "profile": "Desk",
      "timeoutMs": 12000
    },
    {
      "kind": "expectHook",
      "field": "profile",
      "value": "Desk"
    },
    {
      "kind": "beat",
      "ms": 2500
    },
    {
      "kind": "caption",
      "text": "Disconnect it to trigger the single-display profile rule."
    },
    {
      "kind": "virtualDisplay",
      "connected": false
    },
    {
      "kind": "waitProfile",
      "profile": "Laptop",
      "timeoutMs": 12000
    },
    {
      "kind": "waitWindows",
      "apps": [
        "Canvas",
        "Docs"
      ]
    },
    {
      "kind": "assertLayout",
      "text": "home"
    },
    {
      "kind": "beat",
      "ms": 2000
    }
  ],
  "openingApps": [
    "Canvas",
    "Docs"
  ],
  "captureSecondary": true
}
