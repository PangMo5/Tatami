keyEquivalent = "1"
appToFocusBundleId = "dev.PangMo5.DemoLab.Editor"

[[profiles.workspaces.apps]]
bundleIdentifier = "dev.PangMo5.DemoLab.Editor"
name = "Editor"
autoOpen = true
layout = "tiled"


[[profiles.workspaces]]
id = "22222222-0000-4000-8000-000000000002"
name = "Review"
symbolIconName = "checkmark.bubble"
kind = "normal"
keyEquivalent = "2"
appToFocusBundleId = "dev.PangMo5.DemoLab.Review"

[[profiles.workspaces.apps]]
bundleIdentifier = "dev.PangMo5.DemoLab.Review"
name = "Review"
autoOpen = true
