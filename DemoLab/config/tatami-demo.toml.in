appToFocusBundleId = "dev.PangMo5.DemoLab.Terminal"

[[profiles.workspaces.apps]]
bundleIdentifier = "dev.PangMo5.DemoLab.Terminal"
name = "Terminal"
autoOpen = true
layout = "tiled"

[[profiles.workspaces]]
id = "22222222-0000-4000-8000-000000000004"
name = "Chat"
symbolIconName = "bubble.left.and.bubble.right"
kind = "normal"
keyEquivalent = "4"
appToFocusBundleId = "dev.PangMo5.DemoLab.Chat"

[[profiles.workspaces.apps]]
bundleIdentifier = "dev.PangMo5.DemoLab.Chat"
name = "Chat"
