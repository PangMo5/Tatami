    "The launch brief is ready. Can you make the headline a little shorter?": {
      "comment": "Story.stringsdata",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The launch brief is ready. Can you make the headline a little shorter?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출시 안내를 준비했어요. 제목을 조금 더 짧게 다듬어줄 수 있나요?"
          }
        },
        "ja": {
