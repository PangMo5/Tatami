    "The product should feel useful before it feels complicated.": {
      "comment": "DocsView.stringsdata",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The product should feel useful before it feels complicated."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복잡한 기능보다 쓸모가 먼저 느껴져야 해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仕組みの複雑さより先に、役立つことが伝わる製品にしましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先让人感到有用，再了解功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先讓人感到實用，再認識功能。"
          }
