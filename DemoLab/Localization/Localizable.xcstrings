    "Use no more than 40 characters. Lead with the benefit, then explain workspaces in the description.": {
      "comment": "DocsView.stringsdata",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use no more than 40 characters. Lead with the benefit, then explain workspaces in the description."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "40자 이내로 써주세요. 좋은 점을 먼저 전하고, 설명에서 작업 공간을 소개해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "40 文字以内で書きましょう。よい点を先に伝え、説明でワークスペースを紹介します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请控制在 40 个字符以内。先说明好处，再在说明中介绍工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請控制在 40 個字元以內。先說明好處，再在說明中介紹工作空間。"
          }
        }
      }
    },
